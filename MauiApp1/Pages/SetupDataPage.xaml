<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pm="clr-namespace:MauiApp1.PageModels"
             xmlns:controls="clr-namespace:MauiApp1.Pages.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiApp1.Pages.SetupDataPage"
             x:Name="SetupDataPageRoot"
             x:DataType="pm:SetupDataPageModel"
             Title="Setup Data">
    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference SetupDataPageRoot}}"
                                        EventName="Appearing"
                                        Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="16">
                <Label Text="Setup Data" FontSize="28" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                    <Button Text="Payment Modes" Clicked="SelectTab" />
                    <Button Grid.Column="1" Text="Categories" Clicked="SelectTab" />
                    <Button Grid.Column="2" Text="Shops" Clicked="SelectTab" />
                </Grid>
                <VerticalStackLayout IsVisible="{Binding IsPaymentModesTab}" Spacing="10">
                    <Label Text="Manage payment modes used by expenses." />
                    <Button Text="Open Payment Modes" Command="{Binding OpenPaymentModesCommand}" />
                </VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding IsCategoriesTab}" Spacing="10">
                    <Label Text="Manage normalized shop categories and icons." />
                    <Button Text="Open Categories" Command="{Binding OpenCategoriesCommand}" />
                </VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding IsShopsTab}" Spacing="10">
                    <Label Text="Manage shops and assign categories." />
                    <Button Text="Open Shops" Command="{Binding OpenShopsCommand}" />
                </VerticalStackLayout>

                <BoxView HeightRequest="2" BackgroundColor="{DynamicResource Primary}" />
                <Label Text="Budget &amp; Income Settings" Style="{StaticResource Title2}" />
                <Label Text="These values are used for Budget calculations and reports. Currency changes display only; stored amounts are not converted." FontSize="13" />

                <Border Stroke="{DynamicResource Primary}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="14" Background="{DynamicResource SurfaceSecondary}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsEditingIncome, Converter={StaticResource InvertedBoolConverter}}">
                            <VerticalStackLayout>
                                <Label Text="Monthly Income" FontAttributes="Bold" />
                                <Label Text="{Binding MonthlyIncomeDisplay}" FontSize="20" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Edit" Command="{Binding EditIncomeCommand}" VerticalOptions="Center" />
                        </Grid>
                        <VerticalStackLayout IsVisible="{Binding IsEditingIncome}" Spacing="8">
                            <Label Text="Monthly Income" FontAttributes="Bold" />
                            <Entry Text="{Binding MonthlyIncomeEntry}" Keyboard="Numeric" Placeholder="3000,00" />
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Save" Command="{Binding SaveIncomeCommand}" />
                                <Button Text="Cancel" Command="{Binding CancelIncomeEditCommand}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Stroke="{DynamicResource Primary}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="14" Background="{DynamicResource SurfaceSecondary}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsEditingBudget, Converter={StaticResource InvertedBoolConverter}}">
                            <VerticalStackLayout>
                                <Label Text="Monthly Budget" FontAttributes="Bold" />
                                <Label Text="{Binding MonthlyBudgetDisplay}" FontSize="20" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Edit" Command="{Binding EditBudgetCommand}" VerticalOptions="Center" />
                        </Grid>
                        <VerticalStackLayout IsVisible="{Binding IsEditingBudget}" Spacing="8">
                            <Label Text="Monthly Budget" FontAttributes="Bold" />
                            <Entry Text="{Binding MonthlyBudgetEntry}" Keyboard="Numeric" Placeholder="2000,00" />
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Save" Command="{Binding SaveBudgetCommand}" />
                                <Button Text="Cancel" Command="{Binding CancelBudgetEditCommand}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Primary}" />
                <Button Text="Recurring Bills" Command="{Binding OpenRecurringBillsCommand}" />
                <Button Text="ETL DATA" Command="{Binding OpenEtlDataCommand}" />
                <Button Text="ETL Data Manage" Command="{Binding OpenEtlDataManageCommand}" />
                <Button Text="ETL DATA MAPPING" Command="{Binding OpenEtlDataMappingCommand}" />
                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Primary}" />
                <Label Text="Manage Expense Data Removal" Style="{StaticResource Title2}" />
                <Button Text="Open Monthly Expense Data" Command="{Binding OpenExpenseDataRemovalCommand}" />
            </VerticalStackLayout>
        </ScrollView>
        <controls:ProcessingOverlay Grid.RowSpan="2" IsBusy="{Binding IsOverlayBusy}" Message="{Binding ProcessingMessage}" SpinnerColor="#3B82F6" ShowProgress="False" />
        <controls:BottomTaskBar Grid.Row="1" />
    </Grid>
</ContentPage>
