<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pm="clr-namespace:MauiApp1.PageModels" xmlns:m="clr-namespace:MauiApp1.Models" xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" xmlns:local="clr-namespace:MauiApp1.Utilities" xmlns:controls="clr-namespace:MauiApp1.Pages.Controls" xmlns:f="clr-namespace:Fonts" x:Class="MauiApp1.Pages.IncomeExpenseFlowPage" x:Name="FlowPage" x:DataType="pm:IncomeExpenseFlowPageModel" Title="Income Expense Flow">
 <ContentPage.Behaviors><toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference FlowPage}}" EventName="Appearing" Command="{Binding AppearingCommand}" /></ContentPage.Behaviors>
 <ContentPage.Resources><ResourceDictionary><local:EuroCurrencyConverter x:Key="EuroCurrencyConverter" /><toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" /></ResourceDictionary></ContentPage.Resources>
 <Grid RowDefinitions="*,Auto"><ScrollView Grid.Row="0"><VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">
  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="2"><Label Text="Income Expense Flow" Style="{StaticResource Title2}" VerticalTextAlignment="Center" LineBreakMode="NoWrap" /><VerticalStackLayout Grid.Column="1" WidthRequest="48" Spacing="0"><ImageButton Command="{Binding PrintIncomeCommand}" IsEnabled="{Binding IsOverlayBusy, Converter={StaticResource InvertedBoolConverter}}" BackgroundColor="Transparent" WidthRequest="48" HeightRequest="36" Padding="10" SemanticProperties.Description="Print income report"><ImageButton.Source><FontImageSource Glyph="{x:Static f:FluentUI.document_print_24_regular}" FontFamily="{x:Static f:FluentUI.FontFamily}" Color="{DynamicResource Primary}" Size="22" /></ImageButton.Source></ImageButton><Label Text="Income" FontSize="9" HorizontalTextAlignment="Center" /></VerticalStackLayout><VerticalStackLayout Grid.Column="2" WidthRequest="48" Spacing="0"><ImageButton Command="{Binding PrintExpenseCommand}" IsEnabled="{Binding IsOverlayBusy, Converter={StaticResource InvertedBoolConverter}}" BackgroundColor="Transparent" WidthRequest="48" HeightRequest="36" Padding="10" SemanticProperties.Description="Print expense report"><ImageButton.Source><FontImageSource Glyph="{x:Static f:FluentUI.document_print_24_regular}" FontFamily="{x:Static f:FluentUI.FontFamily}" Color="{DynamicResource Primary}" Size="22" /></ImageButton.Source></ImageButton><Label Text="Expense" FontSize="9" HorizontalTextAlignment="Center" /></VerticalStackLayout></Grid>
  <Label Text="Period" FontAttributes="Bold" />
  <Grid ColumnDefinitions="*,Auto"><Picker Title="Month" ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding Month}" HorizontalOptions="Fill" /><Button Grid.Column="1" Text="X" Command="{Binding ClearMonthCommand}" IsVisible="{Binding HasMonth}" Padding="10,4" SemanticProperties.Description="Clear month filter" /></Grid>
  <Border Stroke="{DynamicResource Primary}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Background="{DynamicResource SurfaceSecondary}" Padding="4"><Grid ColumnDefinitions="52,*,52" ColumnSpacing="8"><ImageButton Command="{Binding PreviousPeriodCommand}" BackgroundColor="Transparent" WidthRequest="48" HeightRequest="48" Padding="12" SemanticProperties.Description="Previous period"><ImageButton.Source><FontImageSource Glyph="{x:Static f:FluentUI.chevron_left_24_regular}" FontFamily="{x:Static f:FluentUI.FontFamily}" Color="{DynamicResource Primary}" Size="24" /></ImageButton.Source></ImageButton><Label Grid.Column="1" Text="{Binding PeriodDisplayText}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontAttributes="Bold" FontSize="18" /><ImageButton Grid.Column="2" Command="{Binding NextPeriodCommand}" BackgroundColor="Transparent" WidthRequest="48" HeightRequest="48" Padding="12" SemanticProperties.Description="Next period"><ImageButton.Source><FontImageSource Glyph="{x:Static f:FluentUI.chevron_right_24_regular}" FontFamily="{x:Static f:FluentUI.FontFamily}" Color="{DynamicResource Primary}" Size="24" /></ImageButton.Source></ImageButton></Grid></Border>
  <controls:IncomeExpenseFlowChart ItemsSource="{Binding Months}" />
  <Grid ColumnDefinitions="*,Auto"><Label Text="Total Income" /><Label Grid.Column="1" Text="{Binding TotalIncomeText}" TextColor="{DynamicResource Success}" FontAttributes="Bold" /></Grid>
  <Grid ColumnDefinitions="*,Auto"><Label Text="Total Expense" /><Label Grid.Column="1" Text="{Binding TotalExpenseText}" FontAttributes="Bold" /></Grid>
  <CollectionView ItemsSource="{Binding Months}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate x:DataType="m:FinancialFlowMonth"><Grid ColumnDefinitions="42,*,Auto,Auto" Padding="4"><Label Text="{Binding SerialNumber}" /><Label Grid.Column="1" Text="{Binding MonthName}" FontAttributes="Bold" /><Label Grid.Column="2" Text="{Binding IncomeText}" TextColor="{DynamicResource Success}" HorizontalTextAlignment="End" /><Label Grid.Column="3" Text="{Binding ExpenseText}" HorizontalTextAlignment="End" Margin="12,0,0,0" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
 </VerticalStackLayout></ScrollView><controls:ProcessingOverlay Grid.RowSpan="2" IsBusy="{Binding IsOverlayBusy}" Message="{Binding ProcessingMessage}" SpinnerColor="#3B82F6" ShowProgress="False" /><controls:BottomTaskBar Grid.Row="1" /></Grid>
</ContentPage>
