<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pm="clr-namespace:MauiApp1.PageModels" xmlns:m="clr-namespace:MauiApp1.Models" xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" xmlns:local="clr-namespace:MauiApp1.Utilities" xmlns:controls="clr-namespace:MauiApp1.Pages.Controls" xmlns:f="clr-namespace:Fonts" x:Class="MauiApp1.Pages.ExpenseReportPage" x:Name="ReportPage" x:DataType="pm:ExpenseReportPageModel" Title="Expense Report">
 <ContentPage.Behaviors><toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference ReportPage}}" EventName="Appearing" Command="{Binding AppearingCommand}" /></ContentPage.Behaviors>
 <ContentPage.Resources><ResourceDictionary><local:EuroCurrencyConverter x:Key="EuroCurrencyConverter" /><toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" /></ResourceDictionary></ContentPage.Resources>
 <Grid RowDefinitions="*,Auto"><ScrollView Grid.Row="0"><VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Label Text="Expense Report" Style="{StaticResource Title2}" VerticalTextAlignment="Center" /><ImageButton Grid.Column="1" Command="{Binding OpenStatementCommand}" IsEnabled="{Binding HasResults}" BackgroundColor="Transparent" WidthRequest="48" HeightRequest="48" Padding="10" SemanticProperties.Description="Preview expense statement"><ImageButton.Source><FontImageSource Glyph="{x:Static f:FluentUI.document_print_24_regular}" FontFamily="{x:Static f:FluentUI.FontFamily}" Color="{DynamicResource Primary}" Size="24" /></ImageButton.Source></ImageButton></Grid><Label Text="{Binding Description}" /><Border Stroke="{DynamicResource Primary}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Background="{DynamicResource SurfaceSecondary}" Padding="4"><Grid ColumnDefinitions="52,*,52" ColumnSpacing="8"><ImageButton Command="{Binding PreviousCommand}" BackgroundColor="Transparent" WidthRequest="48" HeightRequest="48" Padding="12" SemanticProperties.Description="Previous report period"><ImageButton.Source><FontImageSource Glyph="{x:Static f:FluentUI.chevron_left_24_regular}" FontFamily="{x:Static f:FluentUI.FontFamily}" Color="{DynamicResource Primary}" Size="24" /></ImageButton.Source></ImageButton><Label Grid.Column="1" Text="{Binding PeriodText}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontAttributes="Bold" FontSize="18" /><ImageButton Grid.Column="2" Command="{Binding NextCommand}" BackgroundColor="Transparent" WidthRequest="48" HeightRequest="48" Padding="12" SemanticProperties.Description="Next report period"><ImageButton.Source><FontImageSource Glyph="{x:Static f:FluentUI.chevron_right_24_regular}" FontFamily="{x:Static f:FluentUI.FontFamily}" Color="{DynamicResource Primary}" Size="24" /></ImageButton.Source></ImageButton></Grid></Border><Label Text="Total Expense" HorizontalOptions="Center" /><Label Text="{Binding OverallTotalText}" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" />
  <Label Text="Payment Mode" FontAttributes="Bold" FontSize="20" /><CollectionView ItemsSource="{Binding PaymentModes}" IsVisible="{Binding HasPaymentModes}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate x:DataType="m:PaymentModeExpenseChartData"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="8,5"><Image Source="{Binding IconFileName}" WidthRequest="24" HeightRequest="24" /><Label Grid.Column="1" Text="{Binding PaymentModeName}" MaxLines="1" LineBreakMode="TailTruncation" VerticalOptions="Center" /><Label Grid.Column="2" Text="{Binding TotalValue, Converter={StaticResource EuroCurrencyConverter}}" FontAttributes="Bold" VerticalOptions="Center" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
  <Label Text="Category Breakdown" FontAttributes="Bold" FontSize="20" /><Label Text="Tap a category to view the bills included in its total." /><Label Text="No expenses found for this period." IsVisible="{Binding HasResults, Converter={StaticResource InvertedBoolConverter}}" />
  <CollectionView ItemsSource="{Binding Groups}" IsVisible="{Binding HasResults}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate x:DataType="m:CategoryExpenseGroup"><VerticalStackLayout Spacing="0"><Border StrokeThickness="1" Stroke="{DynamicResource Primary}" Background="{DynamicResource SurfaceSecondary}" Padding="10,8" Margin="0,2"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleCommand, Source={RelativeSource AncestorType={x:Type pm:ExpenseReportPageModel}}}" CommandParameter="{Binding .}" /></Border.GestureRecognizers><Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10"><Image Source="{Binding IconFileName}" WidthRequest="34" HeightRequest="34" /><Label Grid.Column="1" Text="{Binding CategoryName}" TextColor="{Binding HighlightTextColor}" FontAttributes="Bold" FontSize="14" MaxLines="1" LineBreakMode="TailTruncation" VerticalOptions="Center" /><Label Grid.Column="2" Text="{Binding BillCountText}" FontSize="12" VerticalOptions="Center" /><Label Grid.Column="3" Text="{Binding TotalText}" FontAttributes="Bold" FontSize="14" MaxLines="1" VerticalOptions="Center" /><Label Grid.Column="4" Text="{Binding ExpandGlyph}" VerticalOptions="Center" /></Grid></Border><VerticalStackLayout IsVisible="{Binding IsExpanded}" Padding="44,0,0,6" Spacing="2"><Label Text="Bills included in this category" FontAttributes="Bold" /><BindableLayout.ItemsSource><Binding Path="Bills" /></BindableLayout.ItemsSource><BindableLayout.ItemTemplate><DataTemplate x:DataType="m:BillTransaction"><Grid ColumnDefinitions="*,Auto" Padding="0,3"><VerticalStackLayout><Label Text="{Binding BillDate, StringFormat='{0:dd/MM/yyyy}'}" /><Label Text="{Binding ShopName}" FontAttributes="Bold" /><Label Text="{Binding PaymentModeName}" FontSize="12" /></VerticalStackLayout><Label Grid.Column="1" Text="{Binding BillValue, Converter={StaticResource EuroCurrencyConverter}}" VerticalOptions="Center" /></Grid></DataTemplate></BindableLayout.ItemTemplate><Label Text="{Binding TotalText}" FontAttributes="Bold" HorizontalOptions="End" /></VerticalStackLayout></VerticalStackLayout></DataTemplate></CollectionView.ItemTemplate></CollectionView>
  <Label Text="Shop Visit" FontAttributes="Bold" FontSize="20" IsVisible="{Binding HasShopVisits}" />
  <controls:ShopVisitsChart ItemsSource="{Binding ShopVisits}" IsVisible="{Binding HasShopVisits}" ShowSortControl="True" SortAscending="{Binding ShopVisitSortAscending}" StartDate="{Binding StartDate}" EndExclusive="{Binding EndExclusive}" OpenBillsOnSelection="True" IsProcessing="{Binding IsShopVisitBusy}" ProcessingMessage="{Binding ProcessingMessage}" />
  </VerticalStackLayout></ScrollView><controls:ProcessingOverlay Grid.RowSpan="2" IsBusy="{Binding IsOverlayBusy}" Message="{Binding ProcessingMessage}" SpinnerColor="#3B82F6" ShowProgress="False" /><controls:BottomTaskBar Grid.Row="1" /></Grid>
</ContentPage>
