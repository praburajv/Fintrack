<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pageModels="clr-namespace:MauiApp1.PageModels" xmlns:controls="clr-namespace:MauiApp1.Pages.Controls" x:Class="MauiApp1.Pages.BackupDataPage" x:DataType="pageModels:BackupDataPageModel" Title="Backup Data">
 <Grid><ScrollView><VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">
  <Label Text="Backup Data" Style="{StaticResource Title2}" /><Label Text="Create a safe copy of your Household Expense Tracker data." />
  <Label Text="Current Data" FontAttributes="Bold" />
  <Label Text="{Binding CurrentData.ShopCount, StringFormat='Shops: {0}'}" /><Label Text="{Binding CurrentData.PaymentModeCount, StringFormat='Payment Modes: {0}'}" /><Label Text="{Binding CurrentData.BillCount, StringFormat='Bills: {0}'}" />
  <Button Text="Create Backup" Command="{Binding CreateBackupCommand}" />
  <VerticalStackLayout IsVisible="{Binding HasBackup}" Spacing="8">
   <Label Text="Backup Created Successfully" FontAttributes="Bold" /><Label Text="{Binding BackupFileName}" /><Label Text="{Binding CreatedText, StringFormat='Created: {0}'}" />
   <Label Text="{Binding BackupMetadata.ShopCount, StringFormat='Shops: {0}'}" /><Label Text="{Binding BackupMetadata.PaymentModeCount, StringFormat='Payment Modes: {0}'}" /><Label Text="{Binding BackupMetadata.BillCount, StringFormat='Bills: {0}'}" />
   <Button Text="Save Backup" Command="{Binding SaveBackupCommand}" /><Button Text="Share Backup" Command="{Binding ShareBackupCommand}" />
  </VerticalStackLayout>
 </VerticalStackLayout></ScrollView><controls:ProcessingOverlay IsBusy="{Binding IsBusy}" Message="{Binding ProcessingMessage}" /></Grid>
</ContentPage>