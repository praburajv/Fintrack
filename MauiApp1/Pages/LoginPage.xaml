<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:MauiApp1.PageModels" xmlns:controls="clr-namespace:MauiApp1.Pages.Controls" x:Class="MauiApp1.Pages.LoginPage" x:DataType="vm:LoginPageModel" Title="Login">
 <Grid><ScrollView><VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="12">
  <Label Text="Welcome Back" Style="{StaticResource Title1}" /><Label Text="Log in to manage your household expenses." />
  <Entry Placeholder="Username" Text="{Binding Username}" ClearButtonVisibility="WhileEditing" Margin="0,12,0,0" />
  <Entry Placeholder="Password" Text="{Binding Password}" IsPassword="{Binding IsPassword}" />
  <Button Text="{Binding PasswordToggleText}" Command="{Binding TogglePasswordCommand}" HorizontalOptions="Start" Padding="12,6" Margin="0,-4,0,4" />
  <Button Text="Login" Command="{Binding LoginCommand}" HeightRequest="52" FontSize="18" Margin="0,4,0,0" />
  <Button Text="🔒  Login with Fingerprint" Command="{Binding LoginWithBiometricCommand}" IsVisible="{Binding IsBiometricAvailable}" HeightRequest="48" />
  <Button Text="Forgot Password?" Command="{Binding ForgotPasswordCommand}" HorizontalOptions="Center" Padding="8,4" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
  <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,4,0,0"><Label Text="Don't have an account?" VerticalOptions="Center" /><Button Text="Register" Command="{Binding RegisterCommand}" Padding="4,2" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontAttributes="Bold" /></HorizontalStackLayout>
 </VerticalStackLayout></ScrollView><controls:ProcessingOverlay IsBusy="{Binding IsBusy}" Message="Authenticating..." /></Grid>
</ContentPage>
