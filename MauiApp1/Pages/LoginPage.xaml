<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:MauiApp1.PageModels" xmlns:controls="clr-namespace:MauiApp1.Pages.Controls" x:Class="MauiApp1.Pages.LoginPage" x:DataType="vm:LoginPageModel" Title="Login">
 <Grid><ScrollView><VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">
  <Label Text="Welcome Back" Style="{StaticResource Title1}" /><Label Text="Log in to manage your household expenses." />
  <Entry Placeholder="Username" Text="{Binding Username}" ClearButtonVisibility="WhileEditing" />
  <Entry Placeholder="Password" Text="{Binding Password}" IsPassword="{Binding IsPassword}" />
  <Button Text="{Binding PasswordToggleText}" Command="{Binding TogglePasswordCommand}" HorizontalOptions="Start" />
  <Button Text="Login" Command="{Binding LoginCommand}" />
  <HorizontalStackLayout HorizontalOptions="Center" Spacing="6"><Label Text="Don't have an account?" /><Button Text="Register" Command="{Binding RegisterCommand}" Padding="0" /></HorizontalStackLayout>
 </VerticalStackLayout></ScrollView><controls:ProcessingOverlay IsBusy="{Binding IsBusy}" Message="Authenticating..." /></Grid>
</ContentPage>
