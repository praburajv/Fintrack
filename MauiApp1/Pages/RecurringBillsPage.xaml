<?xml version="1.0" encoding="utf-8" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pm="clr-namespace:MauiApp1.PageModels" xmlns:m="clr-namespace:MauiApp1.Models" xmlns:controls="clr-namespace:MauiApp1.Pages.Controls" xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" x:Class="MauiApp1.Pages.RecurringBillsPage" x:Name="Page" x:DataType="pm:RecurringBillsPageModel" Title="Recurring Bills"><ContentPage.Resources><ResourceDictionary><toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" /></ResourceDictionary></ContentPage.Resources><ContentPage.Behaviors><toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Page}}" EventName="Appearing" Command="{Binding AppearingCommand}" /></ContentPage.Behaviors><Grid RowDefinitions="*,Auto"><ScrollView><VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}"><Label Text="Recurring Bills" Style="{StaticResource Title2}" /><Label Text="Bills that can be registered once per calendar month." /><Label Text="{Binding TargetMonthText}" FontAttributes="Bold" FontSize="18" /><Button Text="{Binding RegistrationButtonText}" Command="{Binding RegisterCommand}" /><Label Text="CONFIGURED RECURRING BILLS" FontAttributes="Bold" FontSize="18" /><Label Text="No recurring bills configured." IsVisible="{Binding HasItems, Converter={StaticResource InvertedBoolConverter}}" /><CollectionView ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate x:DataType="m:RecurringBill"><Border StrokeThickness="1" Stroke="{DynamicResource Primary}" Background="{DynamicResource SurfaceSecondary}" Padding="14" Margin="0,3" StrokeShape="RoundRectangle 14"><VerticalStackLayout Spacing="6"><Label Text="{Binding Description}" FontAttributes="Bold" FontSize="17" /><Label Text="{Binding ShopName}" /><Label Text="{Binding AmountText}" FontAttributes="Bold" /><Label Text="{Binding StatusText}" /><HorizontalStackLayout Spacing="8"><Button Text="Edit" Command="{Binding EditCommand, Source={RelativeSource AncestorType={x:Type pm:RecurringBillsPageModel}}}" CommandParameter="{Binding .}" /><Button Text="Enable / Disable" Command="{Binding ToggleCommand, Source={RelativeSource AncestorType={x:Type pm:RecurringBillsPageModel}}}" CommandParameter="{Binding .}" /><Button Text="Delete" Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type pm:RecurringBillsPageModel}}}" CommandParameter="{Binding .}" /></HorizontalStackLayout></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView><Button Text="＋ Add Recurring Bill" Command="{Binding AddCommand}" /></VerticalStackLayout></ScrollView><controls:ProcessingOverlay IsBusy="{Binding IsBusy}" Message="Loading recurring bills..." /><controls:BottomTaskBar Grid.Row="1" /></Grid></ContentPage>
