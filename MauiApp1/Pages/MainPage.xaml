<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pageModels="clr-namespace:MauiApp1.PageModels" xmlns:controls="clr-namespace:MauiApp1.Pages.Controls" xmlns:pullToRefresh="clr-namespace:Syncfusion.Maui.Toolkit.PullToRefresh;assembly=Syncfusion.Maui.Toolkit" xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" x:Class="MauiApp1.Pages.MainPage" x:Name="Dashboard" x:DataType="pageModels:MainPageModel" Title="Dashboard">
 <ContentPage.Behaviors><toolkit:EventToCommandBehavior BindingContext="{Binding Path=BindingContext, Source={x:Reference Dashboard}, x:DataType=ContentPage}" EventName="Appearing" Command="{Binding AppearingCommand}" /></ContentPage.Behaviors>
 <ContentPage.Resources><ResourceDictionary><toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" /></ResourceDictionary></ContentPage.Resources>
 <Grid RowDefinitions="*,Auto"><pullToRefresh:SfPullToRefresh Grid.Row="0" IsRefreshing="{Binding IsRefreshing}" RefreshCommand="{Binding RefreshCommand}"><pullToRefresh:SfPullToRefresh.PullableContent><ScrollView><VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">
  <Grid ColumnDefinitions="*,Auto"><Label Text="{Binding CurrentYear, StringFormat='Total Expenses {0}'}" Style="{StaticResource Title2}" SemanticProperties.HeadingLevel="Level1" /><Button Grid.Column="1" Text="Expense Analysis" Clicked="OnExpenseAnalysisClicked" Padding="10,6" /></Grid>
  <Label Text="{Binding AnnualTotalText}" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" />
  <Label Text="{Binding CurrentYear, StringFormat='Expenses by Category {0}'}" Style="{StaticResource Title2}" Margin="0,12,0,0" />
  <controls:CategoryExpenseChart IsVisible="{Binding HasCategoryExpenses}" ItemsSource="{Binding CategoryExpenseData}" CategorySelected="OnCategorySelected" CategoryLegendTapped="OnCategoryLegendTapped" />
  <Label Text="{Binding CurrentMonthTitle}" Style="{StaticResource Title2}" Margin="0,12,0,0" />
  <Label Text="Total Value" />
  <Label Text="{Binding CurrentMonthTotalText}" FontSize="24" FontAttributes="Bold" />
  <controls:CategoryExpenseChart IsVisible="{Binding HasCurrentMonthCategoryExpenses}" ItemsSource="{Binding CurrentMonthCategoryExpenseData}" IsCurrentMonth="True" CategorySelected="OnCategorySelected" CategoryLegendTapped="OnCategoryLegendTapped" />
  <Label Text="{Binding CurrentMonthName, StringFormat='No expenses for {0}'}" IsVisible="{Binding HasCurrentMonthCategoryExpenses, Converter={StaticResource InvertedBoolConverter}}" HorizontalOptions="Center" />
  <Label Text="{Binding CurrentYear, StringFormat='No expenses for {0}'}" IsVisible="{Binding HasCategoryExpenses, Converter={StaticResource InvertedBoolConverter}}" HorizontalOptions="Center" />
  <Label Text="{Binding CurrentYear, StringFormat='Monthly Expenses {0}'}" Style="{StaticResource Title2}" Margin="0,12,0,0" />
  <controls:MonthlyExpenseChart ItemsSource="{Binding MonthlyExpenseData}" MonthSelected="OnMonthSelected" />
  <Label Text="{Binding WeeklyTitle}" Style="{StaticResource Title2}" Margin="0,12,0,0" />
  <Label Text="Total Value" />
  <Label Text="{Binding CurrentWeekTotalText}" FontSize="24" FontAttributes="Bold" />
  <controls:WeeklyExpenseChart ItemsSource="{Binding WeeklyExpenseData}" DaySelected="OnWeeklyDaySelected" />
  </VerticalStackLayout></ScrollView></pullToRefresh:SfPullToRefresh.PullableContent></pullToRefresh:SfPullToRefresh><controls:ProcessingOverlay Grid.RowSpan="2" IsBusy="{Binding IsOverlayBusy}" Message="{Binding ProcessingMessage}" SpinnerColor="#3B82F6" ShowProgress="False" /><controls:BottomTaskBar Grid.Row="1" /></Grid>
</ContentPage>
