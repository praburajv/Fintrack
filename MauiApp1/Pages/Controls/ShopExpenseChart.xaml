<?xml version="1.0" encoding="utf-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:chart="clr-namespace:Syncfusion.Maui.Toolkit.Charts;assembly=Syncfusion.Maui.Toolkit" xmlns:local="clr-namespace:MauiApp1.Utilities" xmlns:models="clr-namespace:MauiApp1.Models" x:Class="MauiApp1.Pages.Controls.ShopExpenseChart" x:Name="ChartContainer" Style="{StaticResource CardStyle}">
 <Border.Resources><ResourceDictionary><local:EuroCurrencyConverter x:Key="EuroCurrencyConverter" /></ResourceDictionary></Border.Resources>
 <VerticalStackLayout>
  <chart:SfCircularChart HeightRequest="300" SemanticProperties.Description="Expenses by shop pie chart">
   <chart:SfCircularChart.Resources><DataTemplate x:Key="ShopTooltipTemplate"><VerticalStackLayout Padding="4"><Label Text="{Binding Item.XValue}" FontAttributes="Bold" /><Label Text="{Binding Item.YValue, Converter={StaticResource EuroCurrencyConverter}}" /></VerticalStackLayout></DataTemplate><DataTemplate x:Key="ShopLabelTemplate"><VerticalStackLayout><Label Text="{Binding Item.XValue}" FontSize="11" /><Label Text="{Binding Item.YValue, Converter={StaticResource EuroCurrencyConverter}}" FontSize="11" /></VerticalStackLayout></DataTemplate></chart:SfCircularChart.Resources>
   <chart:DoughnutSeries ItemsSource="{Binding ItemsSource, Source={x:Reference ChartContainer}}" XBindingPath="ShopName" YBindingPath="TotalValue" PaletteBrushes="{Binding PaletteBrushes, Source={x:Reference ChartContainer}}" ShowDataLabels="True" LabelTemplate="{StaticResource ShopLabelTemplate}" EnableTooltip="True" TooltipTemplate="{StaticResource ShopTooltipTemplate}" InnerRadius="0.6">
    <chart:DoughnutSeries.DataLabelSettings><chart:CircularDataLabelSettings LabelPosition="Outside" SmartLabelAlignment="Shift" /></chart:DoughnutSeries.DataLabelSettings>
    <chart:DoughnutSeries.SelectionBehavior><chart:DataPointSelectionBehavior SelectionBrush="Gray" SelectionChanged="OnSelectionChanged" /></chart:DoughnutSeries.SelectionBehavior>
   </chart:DoughnutSeries>
  </chart:SfCircularChart>
  <FlexLayout BindableLayout.ItemsSource="{Binding ItemsSource, Source={x:Reference ChartContainer}}" Direction="Row" Wrap="Wrap" JustifyContent="Center" AlignItems="Center">
   <BindableLayout.ItemTemplate>
    <DataTemplate x:DataType="models:ShopExpenseChartData">
     <Border Padding="4,0" MinimumHeightRequest="44" HorizontalOptions="Fill" SemanticProperties.Description="Show full shop name" Background="Transparent"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnLegendTapped" /></Border.GestureRecognizers><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6"><BoxView WidthRequest="12" HeightRequest="12" Background="{Binding Color}" VerticalOptions="Center" /><Label Grid.Column="1" Text="{Binding ShopDisplayName}" LineBreakMode="TailTruncation" MaxLines="1" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" FontSize="14" /><Label Grid.Column="2" Text="{Binding TotalValue, Converter={StaticResource EuroCurrencyConverter}}" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" /> </Grid></Border>
    </DataTemplate>
   </BindableLayout.ItemTemplate>
  </FlexLayout>
 </VerticalStackLayout>
</Border>
