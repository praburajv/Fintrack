<?xml version="1.0" encoding="utf-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:chart="clr-namespace:Syncfusion.Maui.Toolkit.Charts;assembly=Syncfusion.Maui.Toolkit"
        x:Class="MauiApp1.Pages.Controls.MonthlyVisitsChart"
        x:Name="ChartContainer"
        HeightRequest="320"
        Style="{StaticResource CardStyle}">
    <chart:SfCartesianChart SemanticProperties.Description="Monthly shop visits column chart">
        <chart:SfCartesianChart.XAxes>
            <chart:CategoryAxis Interval="1" LabelsIntersectAction="None" LabelRotation="-45">
                <chart:CategoryAxis.Title><chart:ChartAxisTitle Text="Month" /></chart:CategoryAxis.Title>
            </chart:CategoryAxis>
        </chart:SfCartesianChart.XAxes>
        <chart:SfCartesianChart.YAxes>
            <chart:NumericalAxis Interval="1" Minimum="0" LabelCreated="OnYAxisLabelCreated">
                <chart:NumericalAxis.Title><chart:ChartAxisTitle Text="Visits" /></chart:NumericalAxis.Title>
            </chart:NumericalAxis>
        </chart:SfCartesianChart.YAxes>
        <chart:ColumnSeries ItemsSource="{Binding ItemsSource, Source={x:Reference ChartContainer}}"
                            XBindingPath="MonthName"
                            YBindingPath="VisitCount"
                            PaletteBrushes="{Binding PaletteBrushes, Source={x:Reference ChartContainer}}"
                            ShowDataLabels="True"
                            EnableTooltip="True">
            <chart:ColumnSeries.SelectionBehavior>
                <chart:DataPointSelectionBehavior SelectionBrush="Gray" SelectionChanged="OnSelectionChanged" />
            </chart:ColumnSeries.SelectionBehavior>
        </chart:ColumnSeries>
    </chart:SfCartesianChart>
</Border>
