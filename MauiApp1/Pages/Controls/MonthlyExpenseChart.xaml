<?xml version="1.0" encoding="utf-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:chart="clr-namespace:Syncfusion.Maui.Toolkit.Charts;assembly=Syncfusion.Maui.Toolkit" x:Class="MauiApp1.Pages.Controls.MonthlyExpenseChart" x:Name="ChartContainer" HeightRequest="320" Style="{StaticResource CardStyle}">
 <chart:SfCartesianChart SemanticProperties.Description="Monthly expenses column chart">
  <chart:SfCartesianChart.XAxes><chart:CategoryAxis><chart:CategoryAxis.Title><chart:ChartAxisTitle Text="Month" /></chart:CategoryAxis.Title></chart:CategoryAxis></chart:SfCartesianChart.XAxes>
  <chart:SfCartesianChart.YAxes><chart:NumericalAxis><chart:NumericalAxis.Title><chart:ChartAxisTitle Text="Expense" /></chart:NumericalAxis.Title></chart:NumericalAxis></chart:SfCartesianChart.YAxes>
  <chart:ColumnSeries ItemsSource="{Binding ItemsSource, Source={x:Reference ChartContainer}}" XBindingPath="MonthName" YBindingPath="TotalValue" EnableTooltip="True" />
 </chart:SfCartesianChart>
</Border>
