<?xml version="1.0" encoding="utf-8" ?>
<Border
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Toolkit.Charts;assembly=Syncfusion.Maui.Toolkit"
    xmlns:local="clr-namespace:MauiApp1.Utilities"
    x:Class="MauiApp1.Pages.Controls.DailyExpenseTrendChart"
    x:Name="ChartContainer"
    HeightRequest="300"
    Style="{StaticResource CardStyle}">
    <Border.Resources>
        <ResourceDictionary>
            <local:EuroCurrencyConverter x:Key="EuroCurrencyConverter" />
            <DataTemplate x:Key="DailyExpenseTooltipTemplate">
                <VerticalStackLayout Padding="4" Spacing="2">
                    <Label Text="{Binding Item.XValue, StringFormat='Day {0}'}" FontAttributes="Bold" />
                    <Label Text="{Binding Item.YValue, Converter={StaticResource EuroCurrencyConverter}}" />
                </VerticalStackLayout>
            </DataTemplate>
        </ResourceDictionary>
    </Border.Resources>

    <chart:SfCartesianChart
        HeightRequest="280"
        SemanticProperties.Description="Daily expenses trend for the selected month">
        <chart:SfCartesianChart.XAxes>
            <chart:NumericalAxis Minimum="1" Maximum="31" Interval="5">
                <chart:NumericalAxis.Title>
                    <chart:ChartAxisTitle Text="Day" />
                </chart:NumericalAxis.Title>
            </chart:NumericalAxis>
        </chart:SfCartesianChart.XAxes>
        <chart:SfCartesianChart.YAxes>
            <chart:NumericalAxis LabelCreated="OnYAxisLabelCreated">
                <chart:NumericalAxis.Title>
                    <chart:ChartAxisTitle Text="{DynamicResource CurrencyExpenseAxisTitle}" />
                </chart:NumericalAxis.Title>
            </chart:NumericalAxis>
        </chart:SfCartesianChart.YAxes>
        <chart:LineSeries
            ItemsSource="{Binding ItemsSource, Source={x:Reference ChartContainer}}"
            XBindingPath="DayNumber"
            YBindingPath="TotalValue"
            Fill="#1677FF"
            StrokeWidth="2.5"
            ShowMarkers="True"
            EnableTooltip="True"
            TooltipTemplate="{StaticResource DailyExpenseTooltipTemplate}">
            <chart:LineSeries.MarkerSettings>
                <chart:ChartMarkerSettings Fill="#1677FF" Stroke="White" StrokeWidth="1" Height="7" Width="7" />
            </chart:LineSeries.MarkerSettings>
            <chart:LineSeries.SelectionBehavior>
                <chart:DataPointSelectionBehavior SelectionBrush="#0B4FA3" SelectionChanged="OnSelectionChanged" />
            </chart:LineSeries.SelectionBehavior>
        </chart:LineSeries>
    </chart:SfCartesianChart>
</Border>
