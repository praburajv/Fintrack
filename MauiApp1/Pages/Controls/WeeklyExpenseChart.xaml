<?xml version="1.0" encoding="utf-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:chart="clr-namespace:Syncfusion.Maui.Toolkit.Charts;assembly=Syncfusion.Maui.Toolkit" xmlns:local="clr-namespace:MauiApp1.Utilities" x:Class="MauiApp1.Pages.Controls.WeeklyExpenseChart" x:Name="ChartContainer" HeightRequest="320" Style="{StaticResource CardStyle}">
 <Border.Resources><ResourceDictionary><local:EuroCurrencyConverter x:Key="EuroCurrencyConverter" /><DataTemplate x:Key="WeeklyLabelTemplate"><Label Text="{Binding Item.YValue, Converter={StaticResource EuroCurrencyConverter}}" FontSize="11" /></DataTemplate><DataTemplate x:Key="WeeklyTooltipTemplate"><VerticalStackLayout Padding="4"><Label Text="{Binding Item.XValue}" FontAttributes="Bold" /><Label Text="{Binding Item.YValue, Converter={StaticResource EuroCurrencyConverter}}" /></VerticalStackLayout></DataTemplate></ResourceDictionary></Border.Resources>
 <chart:SfCartesianChart IsTransposed="True" HeightRequest="300" SemanticProperties.Description="Current week expenses bar chart">
  <chart:SfCartesianChart.XAxes><chart:CategoryAxis Interval="1" /></chart:SfCartesianChart.XAxes>
  <chart:SfCartesianChart.YAxes><chart:NumericalAxis LabelCreated="OnYAxisLabelCreated"><chart:NumericalAxis.Title><chart:ChartAxisTitle Text="{DynamicResource CurrencyExpenseAxisTitle}" /></chart:NumericalAxis.Title></chart:NumericalAxis></chart:SfCartesianChart.YAxes>
  <chart:ColumnSeries ItemsSource="{Binding ItemsSource, Source={x:Reference ChartContainer}}" XBindingPath="DisplayLabel" YBindingPath="TotalValue" ShowDataLabels="True" LabelTemplate="{StaticResource WeeklyLabelTemplate}" EnableTooltip="True" TooltipTemplate="{StaticResource WeeklyTooltipTemplate}"><chart:ColumnSeries.SelectionBehavior><chart:DataPointSelectionBehavior SelectionBrush="Gray" SelectionChanged="OnSelectionChanged" /></chart:ColumnSeries.SelectionBehavior></chart:ColumnSeries>
 </chart:SfCartesianChart>
</Border>
