<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pm="clr-namespace:MauiApp1.PageModels" xmlns:m="clr-namespace:MauiApp1.Models" xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" xmlns:local="clr-namespace:MauiApp1.Utilities" xmlns:controls="clr-namespace:MauiApp1.Pages.Controls" xmlns:f="clr-namespace:Fonts" x:Class="MauiApp1.Pages.ExpenseAnalysisPage" x:Name="AnalysisPage" x:DataType="pm:ExpenseAnalysisPageModel" Title="Expense Analysis">
 <ContentPage.Behaviors><toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference AnalysisPage}}" EventName="Appearing" Command="{Binding AppearingCommand}" /></ContentPage.Behaviors>
 <ContentPage.Resources><ResourceDictionary><local:EuroCurrencyConverter x:Key="EuroCurrencyConverter" /><toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" /></ResourceDictionary></ContentPage.Resources>
 <Grid RowDefinitions="*,Auto"><ScrollView Grid.Row="0"><VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Label Text="Expense Analysis" Style="{StaticResource Title2}" VerticalTextAlignment="Center" /><ImageButton Grid.Column="1" Command="{Binding OpenStatementCommand}" IsEnabled="{Binding HasResults}" BackgroundColor="Transparent" WidthRequest="48" HeightRequest="48" Padding="10" SemanticProperties.Description="Preview expense statement"><ImageButton.Source><FontImageSource Glyph="{x:Static f:FluentUI.document_print_24_regular}" FontFamily="{x:Static f:FluentUI.FontFamily}" Color="{DynamicResource Primary}" Size="24" /></ImageButton.Source></ImageButton></Grid><Label Text="Period" FontAttributes="Bold" /><Picker ItemsSource="{Binding PeriodTypes}" SelectedItem="{Binding PeriodType}" HorizontalOptions="Fill" /><Border Stroke="{DynamicResource Primary}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Background="{DynamicResource SurfaceSecondary}" Padding="4"><Grid ColumnDefinitions="52,*,52" ColumnSpacing="8"><ImageButton Command="{Binding PreviousCommand}" BackgroundColor="Transparent" WidthRequest="48" HeightRequest="48" Padding="12" SemanticProperties.Description="Previous period"><ImageButton.Source><FontImageSource Glyph="{x:Static f:FluentUI.chevron_left_24_regular}" FontFamily="{x:Static f:FluentUI.FontFamily}" Color="{DynamicResource Primary}" Size="24" /></ImageButton.Source></ImageButton><Label Grid.Column="1" Text="{Binding PeriodText}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontAttributes="Bold" FontSize="18" /><ImageButton Grid.Column="2" Command="{Binding NextCommand}" BackgroundColor="Transparent" WidthRequest="48" HeightRequest="48" Padding="12" SemanticProperties.Description="Next period"><ImageButton.Source><FontImageSource Glyph="{x:Static f:FluentUI.chevron_right_24_regular}" FontFamily="{x:Static f:FluentUI.FontFamily}" Color="{DynamicResource Primary}" Size="24" /></ImageButton.Source></ImageButton></Grid></Border><Label Text="Total Expense" HorizontalOptions="Center" /><Label Text="{Binding OverallTotalText}" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" />
  <Label Text="Payment Mode" FontAttributes="Bold" FontSize="20" /><CollectionView ItemsSource="{Binding PaymentModes}" IsVisible="{Binding HasPaymentModes}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate x:DataType="m:PaymentModeExpenseChartData"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="8,5"><Image Source="{Binding IconFileName}" WidthRequest="24" HeightRequest="24" /><Label Grid.Column="1" Text="{Binding PaymentModeName}" MaxLines="1" LineBreakMode="TailTruncation" VerticalOptions="Center" /><Label Grid.Column="2" Text="{Binding TotalValue, Converter={StaticResource EuroCurrencyConverter}}" FontAttributes="Bold" VerticalOptions="Center" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
  <Label Text="No expenses in this period." IsVisible="{Binding HasResults, Converter={StaticResource InvertedBoolConverter}}" HorizontalOptions="Center" /><CollectionView ItemsSource="{Binding Groups}" IsVisible="{Binding HasResults}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate x:DataType="m:CategoryExpenseGroup"><VerticalStackLayout Spacing="0"><Border StrokeThickness="0" Background="{DynamicResource SurfaceSecondary}" Padding="10,8" Margin="0,2"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleCommand, Source={RelativeSource AncestorType={x:Type pm:ExpenseAnalysisPageModel}}}" CommandParameter="{Binding .}" /></Border.GestureRecognizers><Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10"><Image Source="{Binding IconFileName}" WidthRequest="34" HeightRequest="34" /><Label Grid.Column="1" Text="{Binding CategoryName}" FontAttributes="Bold" MaxLines="1" LineBreakMode="TailTruncation" VerticalOptions="Center" /><Label Grid.Column="2" Text="{Binding BillCountText}" FontSize="12" VerticalOptions="Center" /><Label Grid.Column="3" Text="{Binding TotalText}" FontAttributes="Bold" VerticalOptions="Center" /><Label Grid.Column="4" Text="{Binding ExpandGlyph}" VerticalOptions="Center" /></Grid></Border><VerticalStackLayout IsVisible="{Binding IsExpanded}" Padding="44,0,0,6" Spacing="2"><BindableLayout.ItemsSource><Binding Path="Bills" /></BindableLayout.ItemsSource><BindableLayout.ItemTemplate><DataTemplate x:DataType="m:BillTransaction"><Grid ColumnDefinitions="*,Auto" Padding="0,3"><VerticalStackLayout><Label Text="{Binding BillDate, StringFormat='{0:dd/MM/yyyy}'}" /><Label Text="{Binding ShopName}" FontAttributes="Bold" /><Label Text="{Binding PaymentModeName}" FontSize="12" /></VerticalStackLayout><Label Grid.Column="1" Text="{Binding BillValue, Converter={StaticResource EuroCurrencyConverter}}" VerticalOptions="Center" /></Grid></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout></DataTemplate></CollectionView.ItemTemplate></CollectionView>
  <VerticalStackLayout IsVisible="{Binding IsMonthlyAnalysis}" Spacing="{StaticResource LayoutSpacing}">
   <Label Text="Daily Expense Trend" Style="{StaticResource Title2}" Margin="0,12,0,0" />
   <controls:DailyExpenseTrendChart ItemsSource="{Binding DailyTrend}" DaySelected="OnTrendDaySelected" />
   <Label Text="Expenses by Category" Style="{StaticResource Title2}" Margin="0,12,0,0" />
   <controls:CategoryExpenseBarChart ItemsSource="{Binding CategoryChartData}" CategorySelected="OnCategorySelected" />
  </VerticalStackLayout>
  <Label Text="Shop Visits" Style="{StaticResource Title2}" Margin="0,12,0,0" />
  <controls:ShopVisitsChart ItemsSource="{Binding ShopVisits}" IsVisible="{Binding HasShopVisits}" ShopSelected="OnShopSelected" />
  <CollectionView ItemsSource="{Binding ShopVisits}" IsVisible="{Binding HasShopVisits}" SelectionMode="None"><CollectionView.Header><Grid ColumnDefinitions="50,*,80,110" Padding="4"><Label Text="S.No" FontAttributes="Bold" /><Label Grid.Column="1" Text="Shop Name" FontAttributes="Bold" /><Label Grid.Column="2" Text="Visits" FontAttributes="Bold" HorizontalTextAlignment="End" /><Label Grid.Column="3" Text="Value" FontAttributes="Bold" HorizontalTextAlignment="End" /></Grid></CollectionView.Header><CollectionView.ItemTemplate><DataTemplate x:DataType="m:ShopExpenseChartData"><Grid ColumnDefinitions="50,*,80,110" Padding="4"><Label Text="{Binding SerialNumber}" /><Label Grid.Column="1" Text="{Binding ShopName}" /><Label Grid.Column="2" Text="{Binding VisitCountText}" HorizontalTextAlignment="End" /><Label Grid.Column="3" Text="{Binding TotalValue, Converter={StaticResource EuroCurrencyConverter}}" HorizontalTextAlignment="End" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
  </VerticalStackLayout></ScrollView><controls:ProcessingOverlay Grid.RowSpan="2" IsBusy="{Binding IsOverlayBusy}" Message="{Binding ProcessingMessage}" SpinnerColor="#3B82F6" ShowProgress="False" /><controls:BottomTaskBar Grid.Row="1" /></Grid>
</ContentPage>
