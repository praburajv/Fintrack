<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pm="clr-namespace:MauiApp1.PageModels" xmlns:m="clr-namespace:MauiApp1.Models" xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" xmlns:controls="clr-namespace:MauiApp1.Pages.Controls" x:Class="MauiApp1.Pages.ShopListPage" x:Name="Page" x:DataType="pm:ShopListPageModel" Title="Shops">
 <ContentPage.Behaviors><toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Page}, x:DataType=ContentPage}" EventName="Appearing" Command="{Binding AppearingCommand}" /></ContentPage.Behaviors>
 <Grid Padding="{StaticResource LayoutPadding}" RowDefinitions="*,Auto">
  <CollectionView Grid.Row="0" ItemsSource="{Binding Items}"><CollectionView.ItemTemplate><DataTemplate x:DataType="m:Shop"><Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Padding="8"><Label Text="{Binding Id}" VerticalOptions="Center" /><Image Grid.Column="1" Source="{Binding IconFileName}" WidthRequest="32" HeightRequest="32" /><VerticalStackLayout Grid.Column="2" VerticalOptions="Center"><Label Text="{Binding Name}" FontAttributes="Bold" /><Label Text="{Binding CategoryName}" FontSize="12" /></VerticalStackLayout><ImageButton Grid.Column="3" Source="edit.svg" Command="{Binding EditCommand, Source={RelativeSource AncestorType={x:Type pm:ShopListPageModel}}}" CommandParameter="{Binding .}" WidthRequest="36" HeightRequest="36" Padding="8" BackgroundColor="Transparent" SemanticProperties.Description="Edit shop" /><ImageButton Grid.Column="4" Source="delete.svg" Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type pm:ShopListPageModel}}}" CommandParameter="{Binding .}" WidthRequest="36" HeightRequest="36" Padding="8" BackgroundColor="Transparent" SemanticProperties.Description="Delete shop" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
  <ImageButton Grid.Row="0" Source="add.svg" Command="{Binding AddCommand}" HorizontalOptions="End" VerticalOptions="End" WidthRequest="52" HeightRequest="52" Padding="12" BackgroundColor="Transparent" SemanticProperties.Description="Add shop" />
  <controls:BottomTaskBar Grid.Row="1" />
 </Grid>
</ContentPage>
