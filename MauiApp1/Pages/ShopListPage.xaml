<?xml version="1.0" encoding="utf-8" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pm="clr-namespace:MauiApp1.PageModels" xmlns:m="clr-namespace:MauiApp1.Models" xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" x:Class="MauiApp1.Pages.ShopListPage" x:Name="Page" x:DataType="pm:ShopListPageModel" Title="Shops"><ContentPage.Behaviors><toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Page}, x:DataType=ContentPage}" EventName="Appearing" Command="{Binding AppearingCommand}" /></ContentPage.Behaviors><Grid Padding="{StaticResource LayoutPadding}"><CollectionView ItemsSource="{Binding Items}"><CollectionView.ItemTemplate><DataTemplate x:DataType="m:Shop"><Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="8"><Label Text="{Binding Id}" /><Label Grid.Column="1" Text="{Binding Name}" /><Button Grid.Column="2" Text="Edit" Command="{Binding EditCommand, Source={RelativeSource AncestorType={x:Type pm:ShopListPageModel}}}" CommandParameter="{Binding .}" /><Button Grid.Column="3" Text="Delete" Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type pm:ShopListPageModel}}}" CommandParameter="{Binding .}" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView><Button Text="ADD" Command="{Binding AddCommand}" HorizontalOptions="End" VerticalOptions="End" /></Grid></ContentPage>
