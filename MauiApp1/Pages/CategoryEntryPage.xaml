<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pm="clr-namespace:MauiApp1.PageModels" xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit" x:Class="MauiApp1.Pages.CategoryEntryPage" x:DataType="pm:CategoryEntryPageModel" Title="Category">
  <Grid><ScrollView><VerticalStackLayout Padding="20" Spacing="16">
    <sf:SfTextInputLayout Hint="Category name"><Entry Text="{Binding Name}" MaxLength="225" /></sf:SfTextInputLayout>
    <sf:SfTextInputLayout Hint="Budgeted"><Entry Text="{Binding BudgetedText}" Keyboard="Numeric" Placeholder="3000,00" /></sf:SfTextInputLayout>
    <Label Text="Icon" FontAttributes="Bold" /><Picker ItemsSource="{Binding IconOptions}" SelectedItem="{Binding SelectedIcon}" />
    <HorizontalStackLayout Spacing="10"><Image Source="{Binding IconPreview}" WidthRequest="40" HeightRequest="40" /><Label Text="Icon preview" VerticalOptions="Center" /></HorizontalStackLayout>
    <HorizontalStackLayout Spacing="12"><Button Text="Save" Command="{Binding SaveCommand}" /><Button Text="Cancel" Command="{Binding CancelCommand}" /></HorizontalStackLayout>
  </VerticalStackLayout></ScrollView></Grid>
</ContentPage>
