<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pm="clr-namespace:MauiApp1.PageModels"
             xmlns:controls="clr-namespace:MauiApp1.Pages.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiApp1.Pages.BillAnalysisPage"
             x:Name="AnalysisPage"
             x:DataType="pm:BillAnalysisPageModel"
             Title="Bill Analysis">
    <ContentPage.Resources><ResourceDictionary><toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" /></ResourceDictionary></ContentPage.Resources>
    <ContentPage.Behaviors><toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference AnalysisPage}}" EventName="Appearing" Command="{Binding AppearingCommand}" /></ContentPage.Behaviors>
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">
                <Label Text="Bill Analysis" Style="{StaticResource Title2}" />
                <Label Text="{Binding ShopName}" FontSize="24" FontAttributes="Bold" MaxLines="2" LineBreakMode="TailTruncation" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="Year" FontAttributes="Bold" VerticalOptions="Center" />
                    <Picker Grid.Column="1" ItemsSource="{Binding YearOptions}" SelectedItem="{Binding SelectedYear}" HorizontalOptions="Fill" />
                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" Background="{DynamicResource SurfaceSecondary}" Padding="8,12"><VerticalStackLayout><Label Text="{Binding VisitsText}" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" /><Label Text="Visits" FontSize="12" HorizontalTextAlignment="Center" /></VerticalStackLayout></Border>
                    <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 12" Background="{DynamicResource SurfaceSecondary}" Padding="8,12"><VerticalStackLayout><Label Text="{Binding TotalSpentText}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" MaxLines="1" LineBreakMode="TailTruncation" /><Label Text="Total Spent" FontSize="12" HorizontalTextAlignment="Center" /></VerticalStackLayout></Border>
                    <Border Grid.Column="2" StrokeThickness="0" StrokeShape="RoundRectangle 12" Background="{DynamicResource SurfaceSecondary}" Padding="8,12"><VerticalStackLayout><Label Text="{Binding AverageSpendText}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" MaxLines="1" LineBreakMode="TailTruncation" /><Label Text="Avg / Visit" FontSize="12" HorizontalTextAlignment="Center" /></VerticalStackLayout></Border>
                </Grid>

                <Label Text="{Binding EmptyText}" IsVisible="{Binding HasVisits, Converter={StaticResource InvertedBoolConverter}}" HorizontalOptions="Center" FontAttributes="Italic" />
                <Label Text="Monthly Visits" Style="{StaticResource Title2}" Margin="0,8,0,0" />
                <Label Text="Tap a month bar to see transaction dates." FontSize="13" />
                <controls:MonthlyVisitsChart ItemsSource="{Binding MonthlyVisits}" MonthSelected="OnMonthSelected" />
            </VerticalStackLayout>
        </ScrollView>
        <controls:ProcessingOverlay Grid.RowSpan="2" IsBusy="{Binding IsOverlayBusy}" Message="{Binding ProcessingMessage}" SpinnerColor="#3B82F6" ShowProgress="False" />
        <controls:BottomTaskBar Grid.Row="1" />
    </Grid>
</ContentPage>
