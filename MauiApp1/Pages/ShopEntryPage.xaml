<?xml version="1.0" encoding="utf-8" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pm="clr-namespace:MauiApp1.PageModels" xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit" xmlns:controls="clr-namespace:MauiApp1.Pages.Controls" x:Class="MauiApp1.Pages.ShopEntryPage" x:DataType="pm:ShopEntryPageModel" Title="Shop"><Grid><ScrollView><VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}"><sf:SfTextInputLayout Hint="Shop name"><Entry Text="{Binding Name}" MaxLength="225" /></sf:SfTextInputLayout><Label Text="Shop Category" FontAttributes="Bold" /><Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" /><HorizontalStackLayout Spacing="10"><Image Source="{Binding CategoryIcon}" WidthRequest="36" HeightRequest="36" VerticalOptions="Center" /><Label Text="Icon Preview" VerticalOptions="Center" /></HorizontalStackLayout><HorizontalStackLayout Spacing="12"><ImageButton Source="save.svg" Command="{Binding SaveCommand}" WidthRequest="48" HeightRequest="48" Padding="10" BackgroundColor="Transparent" SemanticProperties.Description="Save shop" /><ImageButton Source="cancel.svg" Command="{Binding CancelCommand}" WidthRequest="48" HeightRequest="48" Padding="10" BackgroundColor="Transparent" SemanticProperties.Description="Cancel" /></HorizontalStackLayout></VerticalStackLayout></ScrollView><controls:ProcessingOverlay IsBusy="{Binding IsBusy}" Message="Saving shop..." /></Grid></ContentPage>
