<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pageModels="clr-namespace:MauiApp1.PageModels" xmlns:controls="clr-namespace:MauiApp1.Pages.Controls" xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" x:Class="MauiApp1.Pages.DailyDashPage" x:Name="DailyDashPageRoot" x:DataType="pageModels:DailyDashPageModel" Title="DailyDash">
 <ContentPage.Resources><ResourceDictionary><toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" /></ResourceDictionary></ContentPage.Resources>
 <ContentPage.Behaviors><toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference DailyDashPageRoot}}" EventName="Appearing" Command="{Binding AppearingCommand}" /></ContentPage.Behaviors>
 <Grid RowDefinitions="*,Auto"><ScrollView Grid.Row="0"><VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">
  <Grid ColumnDefinitions="*,Auto"><Label Text="DailyDash" Style="{StaticResource Title2}" /><Button Grid.Column="1" Text="Budget" Clicked="OnBudgetClicked" Padding="10,6" /></Grid>
  <Label Text="Daily" FontAttributes="Bold" FontSize="20" /><Label Text="{Binding DailyDateText}" /><Label Text="Consumed Value" /><Label Text="{Binding DailyTotalText}" FontSize="24" FontAttributes="Bold" /><Label Text="No expenses today." IsVisible="{Binding HasDailyData, Converter={StaticResource InvertedBoolConverter}}" /><controls:PaymentModeExpenseChart ItemsSource="{Binding DailyData}" StartDate="{Binding Today}" EndDate="{Binding DayEnd}" PaymentModeSelected="OnPaymentModeSelected" /><Button Text="Expense Report" Clicked="OnDailyReportClicked" HorizontalOptions="End" />
  <Label Text="Shop Visit" FontAttributes="Bold" FontSize="20" IsVisible="{Binding HasDailyShopVisits}" />
  <controls:ShopVisitsChart ItemsSource="{Binding DailyShopVisits}" IsVisible="{Binding HasDailyShopVisits}" ShowSortControl="True" StartDate="{Binding Today}" EndExclusive="{Binding DayEnd}" OpenBillsOnSelection="True" IsProcessing="{Binding IsShopVisitBusy}" ProcessingMessage="{Binding ProcessingMessage}" />
  <Label Text="Weekly" FontAttributes="Bold" FontSize="20" /><Label Text="{Binding WeeklyDateText}" /><Label Text="Consumed Value" /><Label Text="{Binding WeeklyTotalText}" FontSize="24" FontAttributes="Bold" /><Label Text="No expenses for the current week." IsVisible="{Binding HasWeeklyData, Converter={StaticResource InvertedBoolConverter}}" /><controls:PaymentModeExpenseChart ItemsSource="{Binding WeeklyData}" StartDate="{Binding WeekStart}" EndDate="{Binding WeekEnd}" PaymentModeSelected="OnPaymentModeSelected" /><Button Text="Expense Report" Clicked="OnWeeklyReportClicked" HorizontalOptions="End" />
  <Label Text="Shop Visit" FontAttributes="Bold" FontSize="20" IsVisible="{Binding HasWeeklyShopVisits}" />
  <controls:ShopVisitsChart ItemsSource="{Binding WeeklyShopVisits}" IsVisible="{Binding HasWeeklyShopVisits}" ShowSortControl="True" StartDate="{Binding WeekStart}" EndExclusive="{Binding WeekEnd}" OpenBillsOnSelection="True" IsProcessing="{Binding IsShopVisitBusy}" ProcessingMessage="{Binding ProcessingMessage}" />
  <Label Text="Monthly" FontAttributes="Bold" FontSize="20" /><Label Text="{Binding MonthlyDateText}" /><Label Text="Consumed Value" /><Label Text="{Binding MonthlyTotalText}" FontSize="24" FontAttributes="Bold" /><Label Text="No expenses for the current month." IsVisible="{Binding HasMonthlyData, Converter={StaticResource InvertedBoolConverter}}" /><controls:PaymentModeExpenseChart ItemsSource="{Binding MonthlyData}" StartDate="{Binding MonthStart}" EndDate="{Binding MonthEnd}" PaymentModeSelected="OnPaymentModeSelected" /><Button Text="Expense Report" Clicked="OnMonthlyReportClicked" HorizontalOptions="End" />
  <Label Text="Shop Visit" FontAttributes="Bold" FontSize="20" IsVisible="{Binding HasMonthlyShopVisits}" />
  <controls:ShopVisitsChart ItemsSource="{Binding MonthlyShopVisits}" IsVisible="{Binding HasMonthlyShopVisits}" ShowSortControl="True" StartDate="{Binding MonthStart}" EndExclusive="{Binding MonthEnd}" OpenBillsOnSelection="True" IsProcessing="{Binding IsShopVisitBusy}" ProcessingMessage="{Binding ProcessingMessage}" />
  </VerticalStackLayout></ScrollView><controls:ProcessingOverlay Grid.RowSpan="2" IsBusy="{Binding IsOverlayBusy}" Message="{Binding ProcessingMessage}" SpinnerColor="#3B82F6" ShowProgress="False" /><controls:BottomTaskBar Grid.Row="1" /></Grid>
</ContentPage>
