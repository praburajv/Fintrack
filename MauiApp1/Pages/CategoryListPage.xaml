<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pm="clr-namespace:MauiApp1.PageModels" xmlns:m="clr-namespace:MauiApp1.Models" xmlns:controls="clr-namespace:MauiApp1.Pages.Controls" x:Class="MauiApp1.Pages.CategoryListPage" x:Name="Page" x:DataType="pm:CategoryListPageModel" Title="Categories"><ContentPage.Behaviors><EventToCommandBehavior xmlns="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" BindingContext="{Binding BindingContext, Source={x:Reference Page}}" EventName="Appearing" Command="{Binding AppearingCommand}" /></ContentPage.Behaviors><Grid Padding="20" RowDefinitions="Auto,*,Auto"><controls:SetupSuggestedSearch Grid.Row="0" Placeholder="Search categories" SearchText="{Binding SearchText, Mode=TwoWay}" Suggestions="{Binding Suggestions}" SelectionCommand="{Binding SelectSuggestionCommand}" /><CollectionView Grid.Row="1" ItemsSource="{Binding Items}"><CollectionView.ItemTemplate><DataTemplate x:DataType="m:Category"><Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="8"><Image Source="{Binding IconFileName}" WidthRequest="32" HeightRequest="32" /><VerticalStackLayout Grid.Column="1"><Label Text="{Binding Name}" FontAttributes="Bold" /><Label Text="{Binding FriendlyIconName}" FontSize="12" /></VerticalStackLayout><ImageButton Grid.Column="2" Source="edit.svg" Command="{Binding EditCommand, Source={RelativeSource AncestorType={x:Type pm:CategoryListPageModel}}}" CommandParameter="{Binding .}" WidthRequest="36" HeightRequest="36" Padding="8" BackgroundColor="Transparent" /><ImageButton Grid.Column="3" Source="delete.svg" Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type pm:CategoryListPageModel}}}" CommandParameter="{Binding .}" WidthRequest="36" HeightRequest="36" Padding="8" BackgroundColor="Transparent" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView><ImageButton Grid.Row="1" Source="add.svg" Command="{Binding AddCommand}" HorizontalOptions="End" VerticalOptions="End" WidthRequest="52" HeightRequest="52" Padding="12" BackgroundColor="Transparent" /><controls:BottomTaskBar Grid.Row="2" /></Grid></ContentPage>
