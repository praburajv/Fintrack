<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pageModels="clr-namespace:MauiApp1.PageModels" xmlns:models="clr-namespace:MauiApp1.Models" xmlns:controls="clr-namespace:MauiApp1.Pages.Controls" xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" xmlns:local="clr-namespace:MauiApp1.Utilities" x:Class="MauiApp1.Pages.MyMExpense" x:Name="ExpensePage" x:DataType="pageModels:ExpenseListPageModel" Title="Expense List">
 <ContentPage.Resources><ResourceDictionary><local:ZeroCountConverter x:Key="IsZeroConverter" /><local:EuroCurrencyConverter x:Key="EuroCurrencyConverter" /><local:ExpandIconConverter x:Key="ExpandIconConverter" /></ResourceDictionary></ContentPage.Resources>
 <ContentPage.Behaviors><toolkit:EventToCommandBehavior BindingContext="{Binding Path=BindingContext, Source={x:Reference ExpensePage}, x:DataType=ContentPage}" EventName="Appearing" Command="{Binding AppearingCommand}" /></ContentPage.Behaviors>
 <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="{StaticResource LayoutPadding}">
  <Label Text="Expense List" Style="{StaticResource Title2}" Margin="0,0,0,8" SemanticProperties.HeadingLevel="Level1" />
  <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
   <Button Text="Shops" Command="{Binding ManageShopsCommand}" SemanticProperties.Description="Manage shops" FontSize="14" Padding="12,8" CornerRadius="10" BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
   <Button Grid.Column="1" Text="Payment Modes" Command="{Binding ManagePaymentModesCommand}" SemanticProperties.Description="Manage payment modes" FontSize="14" Padding="12,8" CornerRadius="10" BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
  </Grid>
  <Grid Grid.Row="2" ColumnDefinitions="48,*,48" ColumnSpacing="6" Margin="0,12,0,0" HorizontalOptions="Fill">
   <Button Text="‹" Command="{Binding PreviousYearCommand}" SemanticProperties.Description="Previous year" FontSize="28" Padding="0" CornerRadius="10" BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
   <Border Grid.Column="1" Stroke="{StaticResource Primary}" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"><Label Text="{Binding YearTitle}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" FontSize="20" SemanticProperties.Description="Selected year" /></Border>
   <Button Grid.Column="2" Text="›" Command="{Binding NextYearCommand}" SemanticProperties.Description="Next year" FontSize="28" Padding="0" CornerRadius="10" BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
  </Grid>
  <Button Grid.Row="3" Text="+  Add Expense" Command="{Binding AddBillCommand}" SemanticProperties.Description="Add expense" HorizontalOptions="End" Margin="0,10,0,0" MinimumWidthRequest="150" Padding="14,8" FontSize="16" CornerRadius="10" />
  <ScrollView Grid.Row="4" Margin="0,12,0,0"><VerticalStackLayout Spacing="8">
   <Label Text="No expenses found." IsVisible="{Binding HasNoExpenses}" HorizontalOptions="Center" Margin="0,24" />
   <VerticalStackLayout BindableLayout.ItemsSource="{Binding Months}" Spacing="8"><BindableLayout.ItemTemplate><DataTemplate x:DataType="models:ExpenseMonthGroup">
    <Border Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground},Dark={StaticResource DarkSecondaryBackground}}" Padding="10"><VerticalStackLayout Spacing="8">
     <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10"><Button Text="{Binding IsExpanded, Converter={StaticResource ExpandIconConverter}}" Command="{Binding BindingContext.ToggleMonthCommand, Source={x:Reference ExpensePage}}" CommandParameter="{Binding .}" FontSize="18" Padding="0" WidthRequest="44" HeightRequest="44" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" /><Label Grid.Column="1" Text="{Binding MonthNumber}" FontAttributes="Bold" VerticalOptions="Center" /><Label Grid.Column="2" Text="{Binding MonthName}" FontAttributes="Bold" VerticalOptions="Center" /><Label Grid.Column="3" Text="{Binding TotalValue, Converter={StaticResource EuroCurrencyConverter}}" FontAttributes="Bold" VerticalOptions="Center" /></Grid>
     <VerticalStackLayout IsVisible="{Binding IsExpanded}" BindableLayout.ItemsSource="{Binding Bills}" Spacing="4"><BindableLayout.ItemTemplate><DataTemplate x:DataType="models:BillTransaction"><Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="6" Padding="0,5"><Label Text="{Binding DisplayNumber}" /><VerticalStackLayout Grid.Column="1"><Label Text="{Binding BillDate, StringFormat='{0:dd/MM/yyyy}'}" /><Label Text="{Binding ShopName}" /><Label Text="{Binding PaymentModeName}" FontSize="12" /></VerticalStackLayout><HorizontalStackLayout Grid.Column="2" Spacing="4"><Label Text="{Binding BillValue, Converter={StaticResource EuroCurrencyConverter}}" VerticalOptions="Center" /><Button Text="Edit" Command="{Binding BindingContext.EditBillCommand, Source={x:Reference ExpensePage}}" CommandParameter="{Binding .}" Padding="8,0" /></HorizontalStackLayout></Grid></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
    </VerticalStackLayout></Border>
   </DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
  </VerticalStackLayout></ScrollView>
  <controls:ProcessingOverlay Grid.RowSpan="5" IsBusy="{Binding IsBusy}" /></Grid>
</ContentPage>
