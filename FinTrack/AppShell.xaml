<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FinTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:pages="clr-namespace:FinTracker.Pages"
    x:Name="RootShell"
    Shell.FlyoutBehavior="Flyout"
    Title="FinTracker"
    BackgroundColor="{DynamicResource PrimaryDark}"
    ForegroundColor="{DynamicResource TextOnPrimary}"
    TitleColor="{DynamicResource TextOnPrimary}"
    Shell.NavBarHasShadow="False">

    <Shell.FlyoutHeader>
        <Border Padding="20,24,20,16" StrokeThickness="0" Background="{DynamicResource SurfaceSecondary}">
            <VerticalStackLayout Spacing="6">
                <Label Text="FinTracker" Style="{StaticResource Title2}" TextColor="{DynamicResource TextPrimary}" />
                <Label Text="Manage your household expenses in one place." TextColor="{DynamicResource TextPrimary}" IsVisible="{Binding IsLoggedOut, Source={x:Reference RootShell}}" />
                <Label Text="Welcome," TextColor="{DynamicResource TextPrimary}" IsVisible="{Binding IsAuthenticated, Source={x:Reference RootShell}}" />
                <Label Text="{Binding CurrentUserName, Source={x:Reference RootShell}}" Style="{StaticResource Title3}" TextColor="{DynamicResource TextPrimary}" IsVisible="{Binding IsAuthenticated, Source={x:Reference RootShell}}" />
                <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsLoggedOut, Source={x:Reference RootShell}}">
                    <Button Text="Login" Clicked="OnLoginClicked" Padding="14,6" />
                    <Button Text="Register" Clicked="OnRegisterClicked" Padding="14,6" />
                </HorizontalStackLayout>
                <Button Text="Logout" Clicked="OnLogoutClicked" Padding="14,6" HorizontalOptions="Start" IsVisible="{Binding IsAuthenticated, Source={x:Reference RootShell}}" />
            </VerticalStackLayout>
        </Border>
    </Shell.FlyoutHeader>

    <ShellContent
        Title="Financial Dashboard"
        Icon="{StaticResource FlyoutIconDashboard}"
        ContentTemplate="{DataTemplate pages:FinancialDashboardPage}"
        Route="main" />

    <ShellContent Title="Reports" Shell.FlyoutItemIsVisible="False"
                  ContentTemplate="{DataTemplate pages:ReportsHubPage}" Route="reportshub" />
    <ShellContent Title="Add" Shell.FlyoutItemIsVisible="False"
                  ContentTemplate="{DataTemplate pages:AddHubPage}" Route="addhub" />

    <!-- Keep the former tile-and-search landing page available without changing its behavior. -->
    <ShellContent
        Title="Dash cool"
        Icon="{StaticResource FlyoutIconDashboard}"
        ContentTemplate="{DataTemplate pages:LandingDashboardPage}"
        Route="dashcool" />

    <ShellContent
        Title="Welcome"
        Shell.FlyoutItemIsVisible="False"
        ContentTemplate="{DataTemplate pages:WelcomePage}"
        Route="welcome" />

    <ShellContent Title="Choose Company" Shell.FlyoutItemIsVisible="False"
                  ContentTemplate="{DataTemplate pages:CompanySelectionPage}" Route="companies" />
    <ShellContent Title="Company management" Shell.FlyoutItemIsVisible="False"
                  ContentTemplate="{DataTemplate pages:FinancialAccountCardsPage}" Route="companymanagement" />

    <!-- Login is a root so startup/logout can replace the authenticated stack. -->
    <ShellContent Title="Login" Shell.FlyoutItemIsVisible="False"
                  ContentTemplate="{DataTemplate pages:LoginPage}" Route="login" />

    <!-- Preserve the existing analytical dashboard as a separate Flyout destination. -->
    <ShellContent
        Title="Expense Analytics Dash"
        Icon="{StaticResource FlyoutIconDashboard}"
        ContentTemplate="{DataTemplate pages:MainPage}"
        Route="dashboard" />

    <ShellContent
        Title="My Financial Entry"
        Icon="{StaticResource FlyoutIconMyExpense}"
        ContentTemplate="{DataTemplate pages:MyMExpense}"
        Route="myexpense" />

    <ShellContent
        Title="Income Analytics Dash"
        Icon="{StaticResource FlyoutIconDashboard}"
        ContentTemplate="{DataTemplate pages:IncomeAnalysisPage}"
        Route="incomeanalysis" />

    <ShellContent
        Title="Income Expense Flow"
        Icon="{StaticResource FlyoutIconDashboard}"
        ContentTemplate="{DataTemplate pages:IncomeExpenseFlowPage}"
        Route="incomeflow" />

    <ShellContent
        Title="DailyDash"
        Icon="{StaticResource FlyoutIconDailyDash}"
        ContentTemplate="{DataTemplate pages:DailyDashPage}"
        Route="dailydash" />

    <ShellContent
        Title="Calendar"
        Icon="{StaticResource FlyoutIconCalendar}"
        ContentTemplate="{DataTemplate pages:MonthlyExpenseCalendarPage}"
        Route="calendar" />

    <!-- Setup is a hidden Shell route so menu and taskbar navigation use the
         same reliable route without adding a duplicate Flyout item. -->
    <ShellContent
        Title="Setup"
        Shell.FlyoutItemIsVisible="False"
        ContentTemplate="{DataTemplate pages:SetupPage}"
        Route="setup" />

    <MenuItem
        Text="DB Tools"
        IconImageSource="{StaticResource FlyoutIconDatabase}"
        IsEnabled="{Binding IsDeveloperBuild, Source={x:Reference RootShell}}"
        Clicked="OnDbToolsClicked"
        SemanticProperties.Description="Open DB Tools options" />

    <!--<ShellContent
        Title="Backup &amp; Restore"
        Icon="{StaticResource IconBackupRestore}"
        ContentTemplate="{DataTemplate pages:BackupRestorePage}"
        Route="backuprestore" />-->

    <MenuItem
        Text="Backup &amp; Restore"
    IconImageSource="{StaticResource FlyoutIconBackupRestore}"
        Clicked="OnBackupRestoreClicked" />

    <MenuItem
        Text="Setup"
        IconImageSource="{StaticResource FlyoutIconSetup}"
        Clicked="OnSetupClicked"
        SemanticProperties.Description="Open application setup" />

    <MenuItem Text="Setup Data" IconImageSource="{StaticResource FlyoutIconDatabase}" Clicked="OnSetupDataClicked" SemanticProperties.Description="Manage payment modes, categories and shops" />
    <MenuItem Text="Financial Accounts" IconImageSource="{StaticResource FlyoutIconDashboard}" Clicked="OnFinancialAccountsClicked" SemanticProperties.Description="Select or manage financial accounts" />

    <MenuItem
        Text="Show introduction"
        IconImageSource="{StaticResource FlyoutIconDashboard}"
        Clicked="OnShowIntroductionClicked"
        SemanticProperties.Description="Show the FinTracker introduction" />

    <MenuItem
        Text="Close Application"
        IconImageSource="{StaticResource FlyoutIconClose}"
        Clicked="OnCloseApplicationClicked"
        SemanticProperties.Description="Close FinTracker" />
    

    <Shell.FlyoutFooter>
        <Grid Padding="15" RowDefinitions="Auto,Auto" RowSpacing="12">
            <Label Text="{Binding VersionText, Source={x:Reference RootShell}}" HorizontalOptions="Center" FontSize="13" />
            <sf:SfSegmentedControl x:Name="ThemeSegmentedControl" 
                Grid.Row="1"
                VerticalOptions="Center" HorizontalOptions="Center" SelectionChanged="SfSegmentedControl_SelectionChanged"
                SegmentWidth="40" SegmentHeight="40">
                <sf:SfSegmentedControl.ItemsSource>
                    <x:Array Type="{x:Type sf:SfSegmentItem}">
                        <sf:SfSegmentItem ImageSource="{StaticResource IconLight}" SemanticProperties.Description="Light mode"/>
                        <sf:SfSegmentItem ImageSource="{StaticResource IconDark}" SemanticProperties.Description="Dark mode"/>
                    </x:Array>
                </sf:SfSegmentedControl.ItemsSource>
            </sf:SfSegmentedControl>
        </Grid>
    </Shell.FlyoutFooter>

</Shell>
