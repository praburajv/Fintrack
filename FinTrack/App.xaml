<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FinTracker"
             x:Class="FinTracker.App">
    <Application.Resources>
        <ResourceDictionary>
            <x:String x:Key="DisplayCurrencySymbol">€</x:String>
            <x:String x:Key="CurrencyExpenseAxisTitle">Expense (€)</x:String>
            <x:String x:Key="CurrencyBillValueHint">Bill value (€)</x:String>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
