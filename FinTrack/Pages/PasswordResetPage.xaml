<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:FinTracker.PageModels" xmlns:models="clr-namespace:FinTracker.Models" xmlns:controls="clr-namespace:FinTracker.Pages.Controls" xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" x:Class="FinTracker.Pages.PasswordResetPage" x:Name="ResetPage" x:DataType="vm:PasswordResetPageModel" Title="Reset Password">
 <ContentPage.Behaviors><toolkit:EventToCommandBehavior BindingContext="{Binding Path=BindingContext, Source={x:Reference ResetPage}, x:DataType=ContentPage}" EventName="Appearing" Command="{Binding AppearingCommand}" /></ContentPage.Behaviors>
 <Grid><ScrollView><VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">
  <Label Text="Reset Password" Style="{StaticResource Title1}" />
  <VerticalStackLayout IsVisible="{Binding HasUsers}" Spacing="10">
   <Label Text="Select User" Style="{StaticResource Title3}" />
   <CollectionView ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" SelectionMode="Single" HeightRequest="140">
    <CollectionView.ItemTemplate><DataTemplate x:DataType="models:LocalUserSummary"><Grid Padding="8,4" RowDefinitions="Auto,Auto"><Label Text="{Binding Name}" FontAttributes="Bold" /><Label Grid.Row="1" Text="{Binding Username}" FontSize="12" /></Grid></DataTemplate></CollectionView.ItemTemplate>
   </CollectionView>
   <Label Text="Selected User" FontAttributes="Bold" /><Label Text="{Binding SelectedUser.Name}" /><Label Text="{Binding SelectedUser.Username}" FontSize="12" />
   <Entry Placeholder="New Password" Text="{Binding NewPassword}" IsPassword="{Binding IsPassword}" /><Entry Placeholder="Retype Password" Text="{Binding RetypePassword}" IsPassword="{Binding IsPassword}" />
   <Button Text="{Binding PasswordToggleText}" Command="{Binding TogglePasswordCommand}" HorizontalOptions="Start" /><Button Text="Change Password" Command="{Binding ChangePasswordCommand}" /><Button Text="Back to Login" Command="{Binding BackToLoginCommand}" />
  </VerticalStackLayout>
  <VerticalStackLayout IsVisible="{Binding NoUsers}" Spacing="10"><Label Text="No Local Account" Style="{StaticResource Title2}" /><Label Text="There are no registered users on this device. Please register a local account first." /><Button Text="Register" Command="{Binding RegisterCommand}" /><Button Text="Back to Login" Command="{Binding BackToLoginCommand}" /></VerticalStackLayout>
 </VerticalStackLayout></ScrollView><controls:ProcessingOverlay IsBusy="{Binding IsBusy}" Message="Changing password..." /></Grid>
</ContentPage>
