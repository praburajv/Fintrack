<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pm="clr-namespace:FinTracker.PageModels" xmlns:controls="clr-namespace:FinTracker.Pages.Controls" x:Class="FinTracker.Pages.EtlDataPage" x:DataType="pm:EtlDataPageModel" Title="ETL DATA">
  <Grid RowDefinitions="*,Auto"><ScrollView><VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}"><Label Text="ETL DATA" Style="{StaticResource Title2}" /><Label Text="Import debit expenses and credit income transactions from a bank statement PDF." /><Label Text="Expense payment mode" /><Picker Title="Select expense payment mode" ItemsSource="{Binding PaymentModes}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedExpensePaymentMode, Mode=TwoWay}" /><Label Text="Income payment mode" /><Picker Title="Select income payment mode" ItemsSource="{Binding PaymentModes}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedIncomePaymentMode, Mode=TwoWay}" /><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><Switch IsToggled="{Binding CreateMissingEtlSetup, Mode=TwoWay}" /><Label Grid.Column="1" Text="Create missing ETL_DT category and ETL_DATA_VAULT holding shop for this company" VerticalOptions="Center" /></Grid><Button Text="Select PDF and Import" Command="{Binding ImportCommand}" /><Label Text="{Binding StatusText}" /><Label Text="{Binding SummaryText}" FontAttributes="Bold" /></VerticalStackLayout></ScrollView><controls:ProcessingOverlay Grid.RowSpan="2" IsBusy="{Binding IsBusy}" Message="{Binding StatusText}" ShowProgress="False" /><controls:BottomTaskBar Grid.Row="1" /></Grid>
</ContentPage>
