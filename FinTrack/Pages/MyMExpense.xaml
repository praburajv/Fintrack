<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pageModels="clr-namespace:FinTracker.PageModels" xmlns:models="clr-namespace:FinTracker.Models" xmlns:controls="clr-namespace:FinTracker.Pages.Controls" xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" xmlns:local="clr-namespace:FinTracker.Utilities" x:Class="FinTracker.Pages.MyMExpense" x:Name="ExpensePage" x:DataType="pageModels:ExpenseListPageModel" Title="Income Expense List">
 <ContentPage.Resources><ResourceDictionary><local:ZeroCountConverter x:Key="IsZeroConverter" /><local:EuroCurrencyConverter x:Key="EuroCurrencyConverter" /><local:ExpandIconConverter x:Key="ExpandIconConverter" /><DataTemplate x:Key="FinancialCategoryTemplate" x:DataType="models:CategoryExpenseGroup"><VerticalStackLayout Spacing="0"><Grid ColumnDefinitions="Auto,36,*,Auto,Auto" ColumnSpacing="8" Padding="0,5"><Button Text="{Binding ExpandGlyph}" Command="{Binding BindingContext.ToggleCategoryCommand, Source={x:Reference ExpensePage}}" CommandParameter="{Binding .}" FontSize="16" Padding="0" WidthRequest="36" HeightRequest="36" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" /><Image Grid.Column="1" Source="{Binding IconFileName}" WidthRequest="28" HeightRequest="28" VerticalOptions="Center" /><Label Grid.Column="2" Text="{Binding CategoryName}" FontAttributes="Bold" VerticalOptions="Center" MaxLines="1" LineBreakMode="TailTruncation" /><Label Grid.Column="3" Text="{Binding BillCountText}" FontSize="12" VerticalOptions="Center" /><Label Grid.Column="4" Text="{Binding TotalExpense, Converter={StaticResource EuroCurrencyConverter}}" TextColor="{Binding TotalTextColor}" FontAttributes="Bold" VerticalOptions="Center" /></Grid><VerticalStackLayout IsVisible="{Binding IsExpanded}" Padding="44,0,0,4" Spacing="4" BindableLayout.ItemsSource="{Binding Bills}"><BindableLayout.ItemTemplate><DataTemplate x:DataType="models:BillTransaction"><Grid ColumnDefinitions="24,36,*,Auto" ColumnSpacing="6" Padding="0,5"><Label Text="{Binding DisplayNumber}" /><Image Grid.Column="1" Source="{Binding ShopIconFileName}" WidthRequest="32" HeightRequest="32" VerticalOptions="Center" /><VerticalStackLayout Grid.Column="2"><Label Text="{Binding BillDate, StringFormat='{0:dd/MM/yyyy}'}" /><Label Text="{Binding ShopName}" /><Label Text="{Binding ReferenceText}" IsVisible="{Binding HasReference}" FontSize="12" /><Label Text="{Binding PaymentModeName}" FontSize="12" /></VerticalStackLayout><HorizontalStackLayout Grid.Column="3" Spacing="4"><Label Text="{Binding BillValue, Converter={StaticResource EuroCurrencyConverter}}" TextColor="{Binding AmountTextColor}" VerticalOptions="Center" /><ImageButton Source="edit.svg" Command="{Binding BindingContext.EditBillCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}" IsVisible="{Binding BindingContext.CanMaintainExpenses, Source={RelativeSource AncestorType={x:Type ContentPage}}}" IsEnabled="{Binding BindingContext.CanMaintainExpenses, Source={RelativeSource AncestorType={x:Type ContentPage}}}" WidthRequest="36" HeightRequest="36" Padding="8" BackgroundColor="Transparent" SemanticProperties.Description="Edit transaction" /></HorizontalStackLayout></Grid></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout></DataTemplate></ResourceDictionary></ContentPage.Resources>
 <ContentPage.Behaviors><toolkit:EventToCommandBehavior BindingContext="{Binding Path=BindingContext, Source={x:Reference ExpensePage}, x:DataType=ContentPage}" EventName="Appearing" Command="{Binding AppearingCommand}" /></ContentPage.Behaviors>
 <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Padding="{StaticResource LayoutPadding}">
  <Label Text="Income Expense List" Style="{StaticResource Title2}" Margin="0,0,0,8" SemanticProperties.HeadingLevel="Level1" />
  <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
   <Button Text="Shops" Command="{Binding ManageShopsCommand}" SemanticProperties.Description="Manage shops" FontSize="14" Padding="12,8" CornerRadius="10" BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
  </Grid>
  <Grid Grid.Row="2" ColumnDefinitions="48,*,48" ColumnSpacing="6" Margin="0,12,0,0" HorizontalOptions="Fill">
   <Button Text="‹" Command="{Binding PreviousYearCommand}" SemanticProperties.Description="Previous year" FontSize="28" Padding="0" CornerRadius="10" BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
   <Border Grid.Column="1" Stroke="{DynamicResource Primary}" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"><Label Text="{Binding YearTitle}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" FontSize="20" SemanticProperties.Description="Selected year" /></Border>
   <Button Grid.Column="2" Text="›" Command="{Binding NextYearCommand}" SemanticProperties.Description="Next year" FontSize="28" Padding="0" CornerRadius="10" BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
  </Grid>
  <HorizontalStackLayout Grid.Row="3" IsVisible="{Binding CanMaintainExpenses}" HorizontalOptions="End" Margin="0,10,0,0" Spacing="4"><ImageButton Source="add.svg" Command="{Binding AddBillCommand}" IsEnabled="{Binding CanMaintainExpenses}" SemanticProperties.Description="Add expense" WidthRequest="44" HeightRequest="44" Padding="10" BackgroundColor="Transparent" /><Label Text="Add" VerticalOptions="Center" FontAttributes="Bold" /></HorizontalStackLayout>
  <ScrollView Grid.Row="4" Margin="0,12,0,0"><VerticalStackLayout Spacing="8">
   <Label Text="No expenses found." IsVisible="{Binding HasNoExpenses}" HorizontalOptions="Center" Margin="0,24" />
   <VerticalStackLayout BindableLayout.ItemsSource="{Binding Months}" Spacing="8"><BindableLayout.ItemTemplate><DataTemplate x:DataType="models:ExpenseMonthGroup">
    <Border Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground},Dark={StaticResource DarkSecondaryBackground}}" Padding="10"><VerticalStackLayout Spacing="8">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10"><Button Text="{Binding IsExpanded, Converter={StaticResource ExpandIconConverter}}" Command="{Binding BindingContext.ToggleMonthCommand, Source={x:Reference ExpensePage}}" CommandParameter="{Binding .}" FontSize="18" Padding="0" WidthRequest="44" HeightRequest="44" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" /><Label Grid.Column="1" Text="{Binding MonthNumber}" FontAttributes="Bold" VerticalOptions="Center" /><Label Grid.Column="2" Text="{Binding MonthName}" FontAttributes="Bold" VerticalOptions="Center" /><VerticalStackLayout Grid.Column="3"><Label Text="{Binding TotalExpense, Converter={StaticResource EuroCurrencyConverter}, StringFormat='Expense: {0}'}" FontAttributes="Bold" /><Label Text="{Binding TotalIncome, Converter={StaticResource EuroCurrencyConverter}, StringFormat='Income: {0}'}" TextColor="{DynamicResource Success}" FontAttributes="Bold" /></VerticalStackLayout></Grid>
     <Label Text="INCOME" FontAttributes="Bold" IsVisible="{Binding IsExpanded}" />
     <VerticalStackLayout IsVisible="{Binding IsExpanded}" BindableLayout.ItemsSource="{Binding IncomeCategories}" BindableLayout.ItemTemplate="{StaticResource FinancialCategoryTemplate}" Spacing="4" />
     <VerticalStackLayout IsVisible="{Binding IsExpanded}" BindableLayout.ItemsSource="{Binding Categories}" BindableLayout.ItemTemplate="{StaticResource FinancialCategoryTemplate}" Spacing="4" />
    </VerticalStackLayout></Border>
   </DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
   </VerticalStackLayout></ScrollView>
  <controls:ProcessingOverlay Grid.RowSpan="6" IsBusy="{Binding IsOverlayBusy}" Message="{Binding ProcessingMessage}" SpinnerColor="#3B82F6" /><controls:BottomTaskBar Grid.Row="5" /></Grid>
</ContentPage>
