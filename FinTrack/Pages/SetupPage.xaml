<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:FinTracker.PageModels" xmlns:controls="clr-namespace:FinTracker.Pages.Controls" xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" x:Class="FinTracker.Pages.SetupPage" x:Name="SetupPageRoot" x:DataType="vm:SetupPageModel" Title="Setup">
 <ContentPage.Resources><ResourceDictionary><toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" /></ResourceDictionary></ContentPage.Resources>
 <Grid RowDefinitions="*,Auto">
  <ScrollView><VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">
   <Label Text="Setup" Style="{StaticResource Title1}" />
   <VerticalStackLayout IsVisible="{Binding IsAuthenticated, Converter={StaticResource InvertedBoolConverter}}" Spacing="12"><Label Text="🔒" FontSize="56" HorizontalOptions="Center" /><Label Text="You must login to access this section." HorizontalOptions="Center" HorizontalTextAlignment="Center" /><Button Text="Login" Clicked="OnLoginClicked" /><HorizontalStackLayout HorizontalOptions="Center"><Label Text="I don't have an account?" VerticalOptions="Center" /><Button Text="Register" Clicked="OnRegisterClicked" Padding="6,2" BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" /></HorizontalStackLayout></VerticalStackLayout>
   <VerticalStackLayout IsVisible="{Binding IsAuthenticated}" Spacing="12"><Label Text="Appearance" Style="{StaticResource Title2}" /><Label Text="Choose your preferred theme" /><Picker Title="Color Theme" ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme}" /><Picker Title="Appearance" ItemsSource="{Binding AvailableAppearances}" SelectedItem="{Binding SelectedAppearance}" /><Button Text="Apply Theme" Command="{Binding ApplyThemeCommand}" /><Label Text="Currency" Style="{StaticResource Title2}" Margin="0,12,0,0" /><Label Text="Currency changes display formatting only. Stored amounts are not converted." /><Picker Title="Display Currency" ItemsSource="{Binding AvailableCurrencies}" SelectedItem="{Binding SelectedCurrency}" ItemDisplayBinding="{Binding DisplayName}" /><Button Text="Apply Currency" Command="{Binding ApplyCurrencyCommand}" /><Label Text="{Binding CurrencyStatusText}" TextColor="{DynamicResource Success}" /><Label Text="Security" Style="{StaticResource Title2}" Margin="0,12,0,0" /><Label Text="Use Android biometric authentication to sign in to this local account." /><Button Text="{Binding IsBiometricEnabled, StringFormat='Use Fingerprint to Login: {0}'}" Command="{Binding ToggleBiometricCommand}" IsEnabled="{Binding IsBiometricAvailable}" /><Button Text="Open Expense List" Clicked="OnExpensesClicked" /><Button Text="Logout" Clicked="OnLogoutClicked" /></VerticalStackLayout>
  </VerticalStackLayout></ScrollView>
  <controls:BottomTaskBar Grid.Row="1" />
 </Grid>
</ContentPage>
