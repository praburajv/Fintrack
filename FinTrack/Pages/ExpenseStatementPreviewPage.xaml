<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pm="clr-namespace:FinTracker.PageModels"
    xmlns:m="clr-namespace:FinTracker.Models"
    xmlns:controls="clr-namespace:FinTracker.Pages.Controls"
    xmlns:f="clr-namespace:Fonts"
    x:Class="FinTracker.Pages.ExpenseStatementPreviewPage"
    x:Name="StatementPage"
    x:DataType="pm:ExpenseStatementPreviewPageModel"
    Title="Expense Statement">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Button Text="Back" Command="{Binding BackCommand}" />
                    <Label Grid.Column="1" Text="Expense Statement" Style="{StaticResource Title2}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    <ImageButton Grid.Column="2" Command="{Binding OpenPdfCommand}" BackgroundColor="Transparent" WidthRequest="48" HeightRequest="48" Padding="10" SemanticProperties.Description="View PDF and print expense statement">
                        <ImageButton.Source><FontImageSource Glyph="{x:Static f:FluentUI.document_print_24_regular}" FontFamily="{x:Static f:FluentUI.FontFamily}" Color="{DynamicResource Primary}" Size="24" /></ImageButton.Source>
                    </ImageButton>
                </Grid>

                <Label Text="{Binding Statement.PeriodTitle}" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label Text="{Binding Statement.StatementTitle}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label Text="{Binding Statement.CurrencyCode, StringFormat='Display currency: {0}'}" HorizontalOptions="Center" />

                <Grid ColumnDefinitions="40,82,*,*,Auto" ColumnSpacing="6" Padding="4,8" BackgroundColor="{DynamicResource Primary}">
                    <Label Text="S.No" TextColor="White" FontAttributes="Bold" FontSize="12" />
                    <Label Grid.Column="1" Text="Date" TextColor="White" FontAttributes="Bold" FontSize="12" />
                    <Label Grid.Column="2" Text="Shop" TextColor="White" FontAttributes="Bold" FontSize="12" />
                    <Label Grid.Column="3" Text="Payment" TextColor="White" FontAttributes="Bold" FontSize="12" />
                    <Label Grid.Column="4" Text="Value" TextColor="White" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="End" />
                </Grid>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Statement.Categories}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:ExpenseStatementCategory">
                            <VerticalStackLayout Spacing="2">
                                <Grid ColumnDefinitions="*,Auto" BackgroundColor="{DynamicResource SurfaceSecondary}" Padding="8,6"><Label Text="{Binding CategoryName}" FontAttributes="Bold" FontSize="17" /><Label Grid.Column="1" Text="{Binding BillCountText}" FontAttributes="Bold" /></Grid>
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="m:ExpenseStatementRow">
                                            <Grid ColumnDefinitions="40,82,*,*,Auto" ColumnSpacing="6" Padding="4,6">
                                                <Label Text="{Binding SerialNumber}" FontSize="12" />
                                                <Label Grid.Column="1" Text="{Binding DateText}" FontSize="12" />
                                                <Label Grid.Column="2" Text="{Binding ShopName}" FontSize="12" LineBreakMode="WordWrap" />
                                                <Label Grid.Column="3" Text="{Binding PaymentModeName}" FontSize="12" LineBreakMode="WordWrap" />
                                                <Label Grid.Column="4" Text="{Binding ValueText}" FontSize="12" HorizontalTextAlignment="End" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Grid ColumnDefinitions="*,Auto" Padding="4,7">
                                    <Label Text="Category Total" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding CategoryTotalText}" FontAttributes="Bold" />
                                </Grid>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,Auto" Padding="8,12" BackgroundColor="{DynamicResource SurfaceSecondary}">
                    <Label Text="Statement Total" FontAttributes="Bold" FontSize="18" />
                    <Label Grid.Column="1" Text="{Binding Statement.OverallTotalText}" FontAttributes="Bold" FontSize="18" />
                </Grid>

                <Label Text="Shop Visit" FontAttributes="Bold" FontSize="20" IsVisible="{Binding Statement.HasShopVisits}" />
                <controls:ShopVisitsChart ItemsSource="{Binding Statement.ShopVisits}" IsVisible="{Binding Statement.HasShopVisits}" ShowSortControl="True" SortAscending="{Binding ShopVisitSortAscending}" StartDate="{Binding Statement.StartDate}" EndExclusive="{Binding Statement.EndExclusive}" OpenBillsOnSelection="True" IsProcessing="{Binding IsShopVisitBusy}" ProcessingMessage="{Binding ProcessingMessage}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Text="View PDF / Print" Command="{Binding OpenPdfCommand}" />
                    <Button Grid.Column="1" Text="Share PDF" Command="{Binding ShareCommand}" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
        <controls:ProcessingOverlay Grid.RowSpan="2" IsBusy="{Binding IsOverlayBusy}" Message="{Binding ProcessingMessage}" SpinnerColor="#3B82F6" ShowProgress="False" />
        <controls:BottomTaskBar Grid.Row="1" />
    </Grid>
</ContentPage>
