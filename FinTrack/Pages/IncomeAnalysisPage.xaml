<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pm="clr-namespace:FinTracker.PageModels" xmlns:m="clr-namespace:FinTracker.Models" xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" xmlns:local="clr-namespace:FinTracker.Utilities" xmlns:controls="clr-namespace:FinTracker.Pages.Controls" x:Class="FinTracker.Pages.IncomeAnalysisPage" x:Name="Page" x:DataType="pm:IncomeAnalysisPageModel" Title="Income Analytics Dash">
 <ContentPage.Resources><ResourceDictionary><local:EuroCurrencyConverter x:Key="EuroCurrencyConverter" /><toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" /></ResourceDictionary></ContentPage.Resources>
 <ContentPage.Behaviors><toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Page}}" EventName="Appearing" Command="{Binding AppearingCommand}" /></ContentPage.Behaviors>
 <Grid RowDefinitions="*,Auto"><ScrollView><VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}"><Label Text="Income Analytics Dash" Style="{StaticResource Title2}" /><Label Text="Period" FontAttributes="Bold" /><Picker ItemsSource="{Binding PeriodTypes}" SelectedItem="{Binding PeriodType}" /><controls:PeriodNavigationControl PeriodText="{Binding PeriodText}" PreviousCommand="{Binding PreviousCommand}" NextCommand="{Binding NextCommand}" /><Label Text="Actual Income" HorizontalOptions="Center" /><Label Text="{Binding OverallTotalText}" TextColor="{DynamicResource Success}" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" /><Label Text="No income in this period." IsVisible="{Binding HasResults, Converter={StaticResource InvertedBoolConverter}}" HorizontalOptions="Center" /><CollectionView ItemsSource="{Binding Groups}" IsVisible="{Binding HasResults}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate x:DataType="m:CategoryExpenseGroup"><VerticalStackLayout><Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="8"><Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleCommand, Source={RelativeSource AncestorType={x:Type pm:IncomeAnalysisPageModel}}}" CommandParameter="{Binding .}" /></Grid.GestureRecognizers><Image Source="{Binding IconFileName}" WidthRequest="30" HeightRequest="30" /><Label Grid.Column="1" Text="{Binding CategoryName}" FontAttributes="Bold" /><Label Grid.Column="2" Text="{Binding TotalText, Converter={StaticResource EuroCurrencyConverter}}" TextColor="{DynamicResource Success}" /><Label Grid.Column="3" Text="{Binding ExpandGlyph}" /></Grid><VerticalStackLayout IsVisible="{Binding IsExpanded}" Padding="44,0,0,4" BindableLayout.ItemsSource="{Binding Bills}"><BindableLayout.ItemTemplate><DataTemplate x:DataType="m:BillTransaction"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding BillDate, StringFormat='{0:dd/MM/yyyy}'}" /><Label Text="{Binding ShopName}" FontAttributes="Bold" /><Label Text="{Binding ReferenceText}" IsVisible="{Binding HasReference}" FontSize="12" /><Label Text="{Binding PaymentModeName}" FontSize="12" /></VerticalStackLayout><Label Grid.Column="1" Text="{Binding BillValue, Converter={StaticResource EuroCurrencyConverter}}" TextColor="{Binding AmountTextColor}" /></Grid></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout></ScrollView><controls:BottomTaskBar Grid.Row="1" /></Grid>
</ContentPage>
