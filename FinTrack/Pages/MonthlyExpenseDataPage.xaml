<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pm="clr-namespace:FinTracker.PageModels" xmlns:m="clr-namespace:FinTracker.Models" xmlns:controls="clr-namespace:FinTracker.Pages.Controls" xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" x:Class="FinTracker.Pages.MonthlyExpenseDataPage" x:Name="Page" x:DataType="pm:MonthlyExpenseDataPageModel" Title="Manage Expense Data">
 <ContentPage.Resources>
  <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
  <Style x:Key="MonthlyActionButton" TargetType="Button">
   <Setter Property="WidthRequest" Value="80" />
   <Setter Property="HeightRequest" Value="44" />
   <Setter Property="Padding" Value="8,0" />
   <Setter Property="FontSize" Value="14" />
   <Setter Property="VerticalOptions" Value="Center" />
  </Style>
 </ContentPage.Resources>
 <ContentPage.Behaviors><toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Page}, x:DataType=ContentPage}" EventName="Appearing" Command="{Binding AppearingCommand}" /></ContentPage.Behaviors>
 <Grid RowDefinitions="Auto,*,Auto" Padding="{StaticResource LayoutPadding}">
  <VerticalStackLayout Grid.Row="0" Spacing="10"><Label Text="Manage Expense Data Removal" Style="{StaticResource Title2}" /><Grid ColumnDefinitions="48,*,48" ColumnSpacing="6"><Button Text="‹" Command="{Binding PreviousYearCommand}" /><Border Grid.Column="1" Stroke="{DynamicResource Primary}" Padding="10"><Label Text="{Binding YearText}" HorizontalOptions="Center" FontAttributes="Bold" FontSize="20" /></Border><Button Grid.Column="2" Text="›" Command="{Binding NextYearCommand}" /></Grid></VerticalStackLayout>
  <CollectionView Grid.Row="1" ItemsSource="{Binding Months}" SelectionMode="None" Margin="0,12,0,0">
   <CollectionView.ItemTemplate>
    <DataTemplate x:DataType="m:ExpenseMonthMaintenanceItem">
     <Border Stroke="{DynamicResource Primary}" StrokeThickness="1" Padding="12" Margin="0,3" Background="{DynamicResource SurfaceSecondary}">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,80,80" ColumnSpacing="8" RowSpacing="12">
       <VerticalStackLayout Grid.ColumnSpan="3" Spacing="4">
        <Label Text="{Binding MonthName}" FontAttributes="Bold" FontSize="17" />
        <Label Text="{Binding BillCount, StringFormat='Expense bills: {0}'}" />
        <Label Text="{Binding ImportedIncomeCount, StringFormat='Imported Income: {0}'}" TextColor="{DynamicResource Success}" />
        <Label Text="{Binding UntrackedIncomeCount, StringFormat='Untracked Income: {0} (review only)'}" FontSize="13" />
       </VerticalStackLayout>
       <Button Grid.Row="1" Grid.Column="1" Text="View" Style="{StaticResource MonthlyActionButton}"
               Command="{Binding ViewMonthCommand, Source={RelativeSource AncestorType={x:Type pm:MonthlyExpenseDataPageModel}}, x:DataType=pm:MonthlyExpenseDataPageModel}"
               CommandParameter="{Binding .}" />
       <Button Grid.Row="1" Grid.Column="2" Text="Delete" Style="{StaticResource MonthlyActionButton}"
               Command="{Binding DeleteMonthCommand, Source={RelativeSource AncestorType={x:Type pm:MonthlyExpenseDataPageModel}}, x:DataType=pm:MonthlyExpenseDataPageModel}"
               CommandParameter="{Binding .}" IsEnabled="{Binding HasDeletableData}"
               BackgroundColor="{DynamicResource Danger}" TextColor="{DynamicResource TextOnDanger}" />
      </Grid>
     </Border>
    </DataTemplate>
   </CollectionView.ItemTemplate>
  </CollectionView>
  <controls:BottomTaskBar Grid.Row="2" />
  <controls:ProcessingOverlay Grid.RowSpan="3" IsBusy="{Binding IsProcessing}" Message="{Binding ProcessingMessage}"
                              ShowProgress="{Binding IsDeletingData}" Progress="{Binding ProgressFraction}" ProgressText="{Binding ProgressText}" />
  <!-- A blocking review layer has explicit buttons, not an Android action
       sheet hidden over a spinner. The same panel serves scope/import/review
       and the final destructive confirmation without duplicating UI. -->
  <Grid Grid.RowSpan="3" ZIndex="110" IsVisible="{Binding IsAwaitingDeletionChoice}" BackgroundColor="#CC000000" InputTransparent="False" Padding="16,24">
   <Border Background="{DynamicResource SurfaceSecondary}" Stroke="{DynamicResource Primary}" StrokeShape="RoundRectangle 12"
           Padding="16" MaximumWidthRequest="520" HorizontalOptions="Fill" VerticalOptions="Fill">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
     <Grid ColumnDefinitions="48,*" ColumnSpacing="12">
      <Image Source="appicon_runtime.svg" WidthRequest="48" HeightRequest="48" Aspect="AspectFit" />
      <Label Grid.Column="1" Text="{Binding DeletionChoiceTitle}" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
     </Grid>
     <ScrollView Grid.Row="1">
      <VerticalStackLayout Spacing="12">
       <Label Text="{Binding DeletionChoiceMessage}" FontSize="15" />
       <Label Text="Choose an option below, or Cancel. No data has been deleted yet." FontSize="13" />
       <VerticalStackLayout BindableLayout.ItemsSource="{Binding DeletionChoices}" Spacing="12">
        <BindableLayout.ItemTemplate>
         <DataTemplate x:DataType="m:MonthlyDeletionChoice">
          <VerticalStackLayout Spacing="4" IsVisible="{Binding IsDestructive, Converter={StaticResource InvertedBoolConverter}}">
           <Button Text="{Binding Title}" FontSize="16" MinimumHeightRequest="48"
                   Command="{Binding ChooseDeletionOptionCommand, Source={RelativeSource AncestorType={x:Type pm:MonthlyExpenseDataPageModel}}, x:DataType=pm:MonthlyExpenseDataPageModel}"
                   CommandParameter="{Binding .}" />
           <Label Text="{Binding Description}" FontSize="13" />
          </VerticalStackLayout>
         </DataTemplate>
        </BindableLayout.ItemTemplate>
       </VerticalStackLayout>
      </VerticalStackLayout>
     </ScrollView>
     <VerticalStackLayout Grid.Row="2" Spacing="8">
      <Button Text="Delete" IsVisible="{Binding IsDeleteConfirmation}" MinimumHeightRequest="48"
              BackgroundColor="{DynamicResource Danger}" TextColor="{DynamicResource TextOnDanger}"
              SemanticProperties.Description="Confirm permanent deletion of the reviewed Expense and Income records"
              Command="{Binding ChooseDeletionOptionCommand}" CommandParameter="{Binding DeleteConfirmationChoice}" />
      <Button Text="Cancel" Command="{Binding CancelDeletionReviewCommand}" MinimumHeightRequest="48"
              SemanticProperties.Description="Cancel review without deleting any records" />
     </VerticalStackLayout>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</ContentPage>
