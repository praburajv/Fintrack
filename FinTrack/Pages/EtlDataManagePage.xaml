<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pm="clr-namespace:FinTracker.PageModels" xmlns:models="clr-namespace:FinTracker.Models" xmlns:controls="clr-namespace:FinTracker.Pages.Controls" xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" xmlns:local="clr-namespace:FinTracker.Utilities" x:Class="FinTracker.Pages.EtlDataManagePage" x:Name="ManagePage" x:DataType="pm:EtlDataManagePageModel" Title="ETL Data Manage">
  <ContentPage.Resources><ResourceDictionary><local:EuroCurrencyConverter x:Key="EuroCurrencyConverter" /><toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" /></ResourceDictionary></ContentPage.Resources>
  <ContentPage.Behaviors><toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference ManagePage}}" EventName="Appearing" Command="{Binding AppearingCommand}" /></ContentPage.Behaviors>
  <Grid RowDefinitions="*,Auto" Padding="{StaticResource LayoutPadding}">
    <ScrollView Grid.Row="0"><VerticalStackLayout Spacing="{StaticResource LayoutSpacing}">
      <Label Text="ETL Data Manage" Style="{StaticResource Title2}" SemanticProperties.HeadingLevel="Level1" />
      <Label Text="{Binding CompanyName}" FontAttributes="Bold" TextColor="{DynamicResource Primary}" />
      <Label Text="Review and process ETL_DT expenses by month. Income imports are not deleted here." />
      <Label Text="{Binding EmptyStateText}" IsVisible="{Binding HasBills, Converter={StaticResource InvertedBoolConverter}}" HorizontalOptions="Center" Margin="0,24" />
      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
        <Button Text="Process all months" Command="{Binding RemapCommand}" IsEnabled="{Binding HasBills}" />
        <Button Grid.Column="1" Text="Delete all" Command="{Binding DeleteAllCommand}" IsEnabled="{Binding HasBills}" BackgroundColor="{DynamicResource Danger}" TextColor="White" />
      </Grid>
      <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Months}">
        <BindableLayout.ItemTemplate><DataTemplate x:DataType="models:EtlMonthGroup">
          <Border Stroke="{DynamicResource Primary}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Background="{DynamicResource SurfaceSecondary}" Padding="10">
            <VerticalStackLayout Spacing="8">
              <Grid ColumnDefinitions="32,*,Auto,Auto" ColumnSpacing="5">
                <Button Text="{Binding ExpandGlyph}" Command="{Binding BindingContext.ToggleMonthCommand, Source={x:Reference ManagePage}}" CommandParameter="{Binding .}" Padding="0" BackgroundColor="Transparent" WidthRequest="32" />
                <VerticalStackLayout Grid.Column="1"><Label Text="{Binding Title}" FontAttributes="Bold" /><Label Text="{Binding Summary}" FontSize="12" /></VerticalStackLayout>
                <Button Grid.Column="2" Text="Process" Command="{Binding BindingContext.ProcessMonthCommand, Source={x:Reference ManagePage}}" CommandParameter="{Binding .}" FontSize="12" Padding="6,4" />
                <Button Grid.Column="3" Text="X" Command="{Binding BindingContext.DeleteMonthCommand, Source={x:Reference ManagePage}}" CommandParameter="{Binding .}" FontSize="12" Padding="7,4" BackgroundColor="{DynamicResource Danger}" TextColor="White" SemanticProperties.Description="Delete this ETL month" />
              </Grid>
              <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="4" BindableLayout.ItemsSource="{Binding Bills}">
                <BindableLayout.ItemTemplate><DataTemplate x:DataType="models:BillTransaction">
                  <Grid ColumnDefinitions="24,32,*,Auto,Auto" ColumnSpacing="6" Padding="0,5">
                    <Label Text="{Binding DisplayNumber}" />
                    <Image Grid.Column="1" Source="{Binding ShopIconFileName}" WidthRequest="30" HeightRequest="30" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="2"><Label Text="{Binding BillDate, StringFormat='{0:dd/MM/yyyy}'}" /><Label Text="{Binding ShopName}" /><Label Text="{Binding PaymentModeName}" FontSize="12" /></VerticalStackLayout>
                    <Label Grid.Column="3" Text="{Binding BillValue, Converter={StaticResource EuroCurrencyConverter}}" VerticalOptions="Center" />
                    <ImageButton Grid.Column="4" Source="delete.svg" Command="{Binding BindingContext.DeleteBillCommand, Source={x:Reference ManagePage}}" CommandParameter="{Binding .}" WidthRequest="34" HeightRequest="34" Padding="7" BackgroundColor="Transparent" SemanticProperties.Description="Delete expense" />
                  </Grid>
                </DataTemplate></BindableLayout.ItemTemplate>
              </VerticalStackLayout>
            </VerticalStackLayout>
          </Border>
        </DataTemplate></BindableLayout.ItemTemplate>
      </VerticalStackLayout>
    </VerticalStackLayout></ScrollView>
    <controls:ProcessingOverlay Grid.RowSpan="2" IsBusy="{Binding IsBusy}" Message="Loading ETL bills..." ShowProgress="False" />
    <controls:BottomTaskBar Grid.Row="1" />
  </Grid>
</ContentPage>
