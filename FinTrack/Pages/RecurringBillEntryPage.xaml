<?xml version="1.0" encoding="utf-8" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pm="clr-namespace:FinTracker.PageModels" xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit" xmlns:controls="clr-namespace:FinTracker.Pages.Controls" x:Class="FinTracker.Pages.RecurringBillEntryPage" x:DataType="pm:RecurringBillEntryPageModel" Title="Recurring Bill"><Grid><ScrollView><VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}"><sf:SfTextInputLayout Hint="Description"><Entry Text="{Binding Description}" MaxLength="1000" /></sf:SfTextInputLayout><sf:SfTextInputLayout Hint="Amount"><Entry Text="{Binding AmountText}" Keyboard="Numeric" Placeholder="0,00" /></sf:SfTextInputLayout><Label Text="Shop" FontAttributes="Bold" /><Picker ItemsSource="{Binding ShopOptions}" SelectedItem="{Binding SelectedShop}" /><Label Text="Payment mode" FontAttributes="Bold" /><Picker ItemsSource="{Binding PaymentModeOptions}" SelectedItem="{Binding SelectedPaymentMode}" /><Label Text="Start month" FontAttributes="Bold" /><Picker ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding SelectedStartMonth}" /><HorizontalStackLayout><CheckBox IsChecked="{Binding HasEndDate}" /><Label Text="Use an end month" VerticalOptions="Center" /></HorizontalStackLayout><Picker ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding SelectedEndMonth}" IsVisible="{Binding HasEndDate}" /><HorizontalStackLayout><CheckBox IsChecked="{Binding IsActive}" /><Label Text="Active" VerticalOptions="Center" /></HorizontalStackLayout><HorizontalStackLayout Spacing="12"><Button Text="Save" Command="{Binding SaveCommand}" /><Button Text="Cancel" Command="{Binding CancelCommand}" /></HorizontalStackLayout></VerticalStackLayout></ScrollView><controls:ProcessingOverlay IsBusy="{Binding IsBusy}" Message="Saving recurring bill..." /></Grid></ContentPage>
