<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FinTracker.Models"
             x:Class="FinTracker.Pages.Controls.SetupSuggestedSearch"
             x:Name="SearchControl">
    <VerticalStackLayout Spacing="6">
        <Border Stroke="{DynamicResource Primary}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Background="{DynamicResource SurfaceSecondary}" Padding="10,4">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Text="⌕" FontSize="26" VerticalOptions="Center" TextColor="{DynamicResource Primary}" />
                <Entry Grid.Column="1" Text="{Binding SearchText, Source={x:Reference SearchControl}, Mode=TwoWay}"
                       Placeholder="{Binding Placeholder, Source={x:Reference SearchControl}}"
                       ClearButtonVisibility="WhileEditing" />
            </Grid>
        </Border>
        <Border IsVisible="{Binding HasSuggestions, Source={x:Reference SearchControl}}"
                Stroke="{DynamicResource Primary}" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                Background="{DynamicResource SurfaceSecondary}" Padding="8">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Suggestions, Source={x:Reference SearchControl}}" Spacing="2">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:SetupSearchSuggestion">
                        <Border StrokeThickness="0" Padding="10,8" Background="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSuggestionTapped" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Name}" MaxLines="1" LineBreakMode="TailTruncation" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </Border>
        <Label Text="No matching records found." IsVisible="{Binding ShowNoMatches, Source={x:Reference SearchControl}}"
               HorizontalOptions="Center" FontAttributes="Italic" />
    </VerticalStackLayout>
</ContentView>
