<?xml version="1.0" encoding="utf-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:chart="clr-namespace:Syncfusion.Maui.Toolkit.Charts;assembly=Syncfusion.Maui.Toolkit" xmlns:local="clr-namespace:FinTracker.Utilities" xmlns:models="clr-namespace:FinTracker.Models" x:Class="FinTracker.Pages.Controls.PaymentModeExpenseChart" x:Name="ChartContainer" Style="{StaticResource CardStyle}">
 <Border.Resources><ResourceDictionary><local:EuroCurrencyConverter x:Key="EuroCurrencyConverter" /></ResourceDictionary></Border.Resources>
 <VerticalStackLayout>
  <chart:SfCircularChart HeightRequest="300" SemanticProperties.Description="Expenses by payment mode pie chart">
   <chart:SfCircularChart.Resources><DataTemplate x:Key="PaymentLabelTemplate"><VerticalStackLayout><Label Text="{Binding Item.XValue}" FontSize="11" /><Label Text="{Binding Item.YValue, Converter={StaticResource EuroCurrencyConverter}}" FontSize="11" /></VerticalStackLayout></DataTemplate></chart:SfCircularChart.Resources>
   <chart:DoughnutSeries ItemsSource="{Binding ItemsSource, Source={x:Reference ChartContainer}}" XBindingPath="DisplayName" YBindingPath="TotalValue" PaletteBrushes="{Binding PaletteBrushes, Source={x:Reference ChartContainer}}" ShowDataLabels="True" LabelTemplate="{StaticResource PaymentLabelTemplate}" EnableTooltip="True" InnerRadius="0.6"><chart:DoughnutSeries.DataLabelSettings><chart:CircularDataLabelSettings LabelPosition="Outside" SmartLabelAlignment="Shift" /></chart:DoughnutSeries.DataLabelSettings><chart:DoughnutSeries.SelectionBehavior><chart:DataPointSelectionBehavior SelectionBrush="Gray" SelectionChanged="OnSelectionChanged" /></chart:DoughnutSeries.SelectionBehavior></chart:DoughnutSeries>
  </chart:SfCircularChart>
  <FlexLayout BindableLayout.ItemsSource="{Binding ItemsSource, Source={x:Reference ChartContainer}}" Direction="Row" Wrap="Wrap" JustifyContent="Center"><BindableLayout.ItemTemplate><DataTemplate x:DataType="models:PaymentModeExpenseChartData"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Padding="4" MinimumHeightRequest="36"><BoxView WidthRequest="12" HeightRequest="12" Background="{Binding Color}" VerticalOptions="Center" /><Label Grid.Column="1" Text="{Binding DisplayName}" FontSize="14" VerticalOptions="Center" /><Label Grid.Column="2" Text="{Binding TotalValue, Converter={StaticResource EuroCurrencyConverter}}" FontSize="14" VerticalOptions="Center" /></Grid></DataTemplate></BindableLayout.ItemTemplate></FlexLayout>
 </VerticalStackLayout>
</Border>
