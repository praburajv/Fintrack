<?xml version="1.0" encoding="utf-8" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pm="clr-namespace:FinTracker.PageModels" xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit" xmlns:controls="clr-namespace:FinTracker.Pages.Controls" x:Class="FinTracker.Pages.PaymentModeEntryPage" x:DataType="pm:PaymentModeEntryPageModel" Title="Payment Mode"><Grid><ScrollView><VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}"><sf:SfTextInputLayout Hint="Payment mode name"><Entry Text="{Binding Name}" MaxLength="225" /></sf:SfTextInputLayout><HorizontalStackLayout Spacing="12"><ImageButton Source="save.svg" Command="{Binding SaveCommand}" WidthRequest="48" HeightRequest="48" Padding="10" BackgroundColor="Transparent" SemanticProperties.Description="Save payment mode" /><ImageButton Source="cancel.svg" Command="{Binding CancelCommand}" WidthRequest="48" HeightRequest="48" Padding="10" BackgroundColor="Transparent" SemanticProperties.Description="Cancel" /></HorizontalStackLayout></VerticalStackLayout></ScrollView><controls:ProcessingOverlay IsBusy="{Binding IsBusy}" Message="Saving payment mode..." /></Grid></ContentPage>
