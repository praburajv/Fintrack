<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pm="clr-namespace:FinTracker.PageModels" xmlns:m="clr-namespace:FinTracker.Models" xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" xmlns:local="clr-namespace:FinTracker.Utilities" xmlns:controls="clr-namespace:FinTracker.Pages.Controls" xmlns:f="clr-namespace:Fonts" x:Class="FinTracker.Pages.MonthlyBudgetReportPage" x:Name="Page" x:DataType="pm:MonthlyBudgetReportPageModel" Title="Monthly Budget Report">
  <ContentPage.Resources><ResourceDictionary><local:EuroCurrencyConverter x:Key="EuroCurrencyConverter" /><toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" /></ResourceDictionary></ContentPage.Resources>
  <ContentPage.Behaviors><toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Page}}" EventName="Appearing" Command="{Binding AppearingCommand}" /></ContentPage.Behaviors>
  <Grid RowDefinitions="*,Auto"><ScrollView Grid.Row="0"><VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Label Text="Monthly Budget Report" Style="{StaticResource Title2}" VerticalTextAlignment="Center" /><ImageButton Grid.Column="1" Command="{Binding OpenBudgetReportCommand}" BackgroundColor="Transparent" WidthRequest="48" HeightRequest="48" Padding="10" SemanticProperties.Description="Preview budget report"><ImageButton.Source><FontImageSource Glyph="{x:Static f:FluentUI.document_print_24_regular}" FontFamily="{x:Static f:FluentUI.FontFamily}" Color="{DynamicResource Primary}" Size="24" /></ImageButton.Source></ImageButton></Grid><Label Text="Understand your budget, income and spending for the selected month." />
    <controls:PeriodNavigationControl PeriodText="{Binding MonthText}" PreviousCommand="{Binding PreviousMonthCommand}" NextCommand="{Binding NextMonthCommand}" />
    <Border StrokeThickness="0" Background="{DynamicResource SurfaceSecondary}" Padding="16" StrokeShape="RoundRectangle 14"><VerticalStackLayout Spacing="6"><Label Text="FINANCIAL OVERVIEW" FontAttributes="Bold" FontSize="18" /><Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasIncome}"><Label Text="Monthly Income" /><Label Grid.Column="1" Text="{Binding IncomeTextForDisplay}" FontAttributes="Bold" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="Monthly Budget" /><Label Grid.Column="1" Text="{Binding MonthlyBudgetText}" FontAttributes="Bold" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="Actual Expense" /><Label Grid.Column="1" Text="{Binding ActualExpenseText}" FontAttributes="Bold" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding BudgetBalanceLabel}" /><Label Grid.Column="1" Text="{Binding BudgetBalanceText}" TextColor="{Binding BudgetBalanceColor}" FontAttributes="Bold" /></Grid><Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasIncome}"><Label Text="{Binding IncomeRemainingLabel}" /><Label Grid.Column="1" Text="{Binding IncomeRemainingText}" FontAttributes="Bold" /></Grid></VerticalStackLayout></Border>
    <Border StrokeThickness="0" Background="{DynamicResource SurfaceSecondary}" Padding="16" StrokeShape="RoundRectangle 14"><VerticalStackLayout Spacing="8"><Label Text="BUDGET HEALTH" FontAttributes="Bold" FontSize="18" /><Label Text="{Binding BudgetUsedPercent, StringFormat='{0} used'}" /><ProgressBar Progress="{Binding BudgetProgress}" ProgressColor="{Binding BudgetHealthColor}" HeightRequest="10" /><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding BudgetBalanceLabel}" /><Label Grid.Column="1" Text="{Binding BudgetBalanceText}" TextColor="{Binding BudgetBalanceColor}" FontAttributes="Bold" /></Grid><Label Text="{Binding BudgetHealthText}" TextColor="{Binding BudgetHealthColor}" FontAttributes="Bold" /></VerticalStackLayout></Border>
    <Label Text="CATEGORY BREAKDOWN" FontAttributes="Bold" FontSize="20" /><Label Text="See where your money went. Tap a category to view the bills included in its expense total." />
    <Label Text="{Binding EmptyMonthText}" IsVisible="{Binding HasConfiguredBudgetWithoutExpenses}" /><Label Text="{Binding EmptyMonthText}" IsVisible="{Binding HasNoInformation}" />
    <CollectionView ItemsSource="{Binding Groups}" IsVisible="{Binding HasResults}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate x:DataType="m:CategoryExpenseGroup"><Border StrokeThickness="1" Stroke="{DynamicResource Primary}" Background="{DynamicResource SurfaceSecondary}" Padding="14" Margin="0,3" StrokeShape="RoundRectangle 14"><VerticalStackLayout Spacing="7"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleCommand, Source={RelativeSource AncestorType={x:Type pm:MonthlyBudgetReportPageModel}}}" CommandParameter="{Binding .}" /></Border.GestureRecognizers><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><Image Source="{Binding IconFileName}" WidthRequest="38" HeightRequest="38" /><Label Grid.Column="1" Text="{Binding CategoryName}" TextColor="{Binding HighlightTextColor}" FontAttributes="Bold" FontSize="17" MaxLines="1" LineBreakMode="TailTruncation" VerticalOptions="Center" /><Label Grid.Column="2" Text="{Binding ExpandGlyph}" VerticalOptions="Center" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="Actual Expense" /><Label Grid.Column="1" Text="{Binding TotalText}" FontAttributes="Bold" /></Grid><Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasBudget}"><Label Text="Budgeted" /><Label Grid.Column="1" Text="{Binding BudgetedText}" FontAttributes="Bold" /></Grid><Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasBudget}"><Label Text="{Binding BudgetBalanceLabel}" /><Label Grid.Column="1" Text="{Binding BudgetBalanceText}" TextColor="{Binding DifferenceTextColor}" FontAttributes="Bold" /></Grid><Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasBudget}"><ProgressBar Progress="{Binding BudgetUsedPercent, Converter={StaticResource EuroCurrencyConverter}}" IsVisible="False" /><Label Text="Budget Used" /><Label Grid.Column="1" Text="{Binding BudgetUsedPercentText}" FontAttributes="Bold" /></Grid><ProgressBar Progress="{Binding BudgetUsedPercent}" IsVisible="False" /><Label Text="{Binding BudgetStatusText}" TextColor="{Binding BudgetStatusColor}" FontAttributes="Bold" /><Label Text="Highest Expense" TextColor="{Binding HighlightTextColor}" IsVisible="{Binding IsHighest}" FontAttributes="Bold" /><VerticalStackLayout IsVisible="{Binding IsExpanded}" Padding="10,4,0,0" Spacing="3"><Label Text="BILLS INCLUDED" FontAttributes="Bold" /><BindableLayout.ItemsSource><Binding Path="Bills" /></BindableLayout.ItemsSource><BindableLayout.ItemTemplate><DataTemplate x:DataType="m:BillTransaction"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding BillDate, StringFormat='{0:dd/MM/yyyy}'}" /><Label Text="{Binding ShopName}" FontAttributes="Bold" /><Label Text="{Binding PaymentModeName}" FontSize="12" /></VerticalStackLayout><Label Grid.Column="1" Text="{Binding BillValue, Converter={StaticResource EuroCurrencyConverter}}" VerticalOptions="Center" /></Grid></DataTemplate></BindableLayout.ItemTemplate><BoxView HeightRequest="1" BackgroundColor="{DynamicResource Primary}" /><Grid ColumnDefinitions="*,Auto"><Label Text="Category Total" FontAttributes="Bold" /><Label Grid.Column="1" Text="{Binding TotalText}" FontAttributes="Bold" /></Grid></VerticalStackLayout></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
  </VerticalStackLayout></ScrollView><controls:ProcessingOverlay Grid.RowSpan="2" IsBusy="{Binding IsOverlayBusy}" Message="{Binding ProcessingMessage}" SpinnerColor="#3B82F6" ShowProgress="False" /><controls:BottomTaskBar Grid.Row="1" /></Grid>
</ContentPage>
