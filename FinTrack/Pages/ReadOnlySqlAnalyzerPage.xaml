<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:FinTracker.Pages.Controls" xmlns:models="clr-namespace:FinTracker.Models" xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" x:Class="FinTracker.Pages.ReadOnlySqlAnalyzerPage" x:Name="AnalyzerPage" Title="SQL Query Analyzer">
 <ContentPage.Resources><ResourceDictionary><toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" /></ResourceDictionary></ContentPage.Resources>
 <Grid RowDefinitions="*,Auto">
  <ScrollView Grid.Row="0"><VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">
   <Label Text="SQL Query Analyzer" Style="{StaticResource Title1}" />
   <Label Text="READ ONLY" TextColor="{DynamicResource Danger}" FontAttributes="Bold" HorizontalOptions="Center" />
   <Border Stroke="{DynamicResource Primary}" StrokeShape="RoundRectangle 12" Padding="10" Background="{DynamicResource SurfaceSecondary}">
    <VerticalStackLayout Spacing="8">
     <Grid ColumnDefinitions="*,Auto"><Label Text="{Binding BuilderHeaderText}" FontAttributes="Bold" VerticalOptions="Center" /><Button Grid.Column="1" Text="⌄" Command="{Binding ToggleBuilderCommand}" WidthRequest="42" HeightRequest="42" Padding="0" SemanticProperties.Description="Expand or collapse query builder" /></Grid>
     <VerticalStackLayout IsVisible="{Binding IsBuilderExpanded}" Spacing="8">
      <Label Text="Table" FontAttributes="Bold" /><Picker ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}" IsEnabled="{Binding IsSchemaBusy, Converter={StaticResource InvertedBoolConverter}}" /><ActivityIndicator IsRunning="{Binding IsSchemaBusy}" IsVisible="{Binding IsSchemaBusy}" />
      <Grid ColumnDefinitions="*,Auto"><Picker Grid.Column="0" Title="Select field" ItemsSource="{Binding QueryFields}" SelectedItem="{Binding SelectedField}" /><ImageButton Grid.Column="1" Source="add.svg" Command="{Binding AddFieldCommand}" WidthRequest="44" HeightRequest="44" Padding="10" SemanticProperties.Description="Add selected field" /></Grid>
      <Label Text="Fields: * (default)" IsVisible="{Binding HasSelectedFields, Converter={StaticResource InvertedBoolConverter}}" />
      <CollectionView ItemsSource="{Binding SelectedFields}" SelectionMode="None" MaximumHeightRequest="90"><CollectionView.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding DisplayName}" VerticalOptions="Center" /><ImageButton Grid.Column="1" Source="cancel.svg" Command="{Binding BindingContext.RemoveFieldCommand, Source={x:Reference AnalyzerPage}}" CommandParameter="{Binding .}" WidthRequest="38" HeightRequest="38" Padding="9" SemanticProperties.Description="Remove selected field" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
      <Label Text="Filters" FontAttributes="Bold" />
      <Grid ColumnDefinitions="*,*,Auto"><Picker Grid.Column="0" Title="Field" ItemsSource="{Binding QueryFields}" SelectedItem="{Binding SelectedConditionField}" /><Picker Grid.Column="1" Title="Operator" ItemsSource="{Binding Operators}" SelectedItem="{Binding ConditionOperator}" /><ImageButton Grid.Column="2" Source="add.svg" Command="{Binding AddConditionCommand}" WidthRequest="44" HeightRequest="44" Padding="10" SemanticProperties.Description="Add filter condition" /></Grid>
      <Entry Placeholder="Value (comma-separated for IN)" Text="{Binding ConditionValue}" IsVisible="{Binding IsValueVisible}" />
      <Entry Placeholder="Second value for BETWEEN" Text="{Binding ConditionSecondValue}" IsVisible="{Binding IsSecondValueVisible}" />
      <Picker Title="Connector" ItemsSource="{Binding Connectors}" SelectedItem="{Binding ConditionConnector}" />
      <CollectionView ItemsSource="{Binding Conditions}" SelectionMode="None" MaximumHeightRequest="120"><CollectionView.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding Summary}" VerticalOptions="Center" /><ImageButton Grid.Column="1" Source="cancel.svg" Command="{Binding BindingContext.RemoveConditionCommand, Source={x:Reference AnalyzerPage}}" CommandParameter="{Binding .}" WidthRequest="38" HeightRequest="38" Padding="9" SemanticProperties.Description="Remove filter condition" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
      <Label Text="Join (maximum one)" FontAttributes="Bold" /><Grid ColumnDefinitions="*,*"><Picker Grid.Column="0" Title="Join table" ItemsSource="{Binding JoinTables}" SelectedItem="{Binding SelectedJoinTable}" /><Picker Grid.Column="1" Title="Type" ItemsSource="{Binding JoinTypes}" SelectedItem="{Binding JoinType}" /></Grid>
      <Grid ColumnDefinitions="*,*" IsVisible="{Binding HasJoin}"><Picker Grid.Column="0" Title="Left field" ItemsSource="{Binding JoinLeftFields}" SelectedItem="{Binding SelectedJoinLeftField}" /><Picker Grid.Column="1" Title="Right field" ItemsSource="{Binding JoinRightFields}" SelectedItem="{Binding SelectedJoinRightField}" /></Grid>
      <Label Text="Sort" FontAttributes="Bold" /><Grid ColumnDefinitions="*,Auto"><Picker Grid.Column="0" Title="Sort field" ItemsSource="{Binding QueryFields}" SelectedItem="{Binding SelectedSortField}" /><Picker Grid.Column="1" Title="Direction" ItemsSource="{Binding SortDirections}" SelectedItem="{Binding SortDirection}" /></Grid>
      <Grid ColumnDefinitions="Auto,*"><Label Text="Limit" VerticalOptions="Center" /><Entry Grid.Column="1" Text="{Binding LimitText}" Keyboard="Numeric" Placeholder="100" /></Grid>
      <Label Text="{Binding BuilderError}" TextColor="{DynamicResource Danger}" IsVisible="{Binding HasBuilderError}" />
      <HorizontalStackLayout Spacing="8"><Button Text="↻ Generate" Command="{Binding GenerateSqlCommand}" SemanticProperties.Description="Generate and validate SQL" /><Button Text="Clear Builder" Command="{Binding ClearBuilderCommand}" /></HorizontalStackLayout>
     </VerticalStackLayout>
    </VerticalStackLayout>
   </Border>
   <Label Text="Database" Style="{StaticResource Title3}" />
   <Label Text="{Binding DatabaseFilename}" />
   <Label Text="SQL Query" Style="{StaticResource Title3}" />
   <Editor Text="{Binding SqlText}" AutoSize="TextChanges" MinimumHeightRequest="140" Placeholder="Enter a SELECT query" Keyboard="Chat" />
   <HorizontalStackLayout Spacing="8"><Button Text="Execute Query" Command="{Binding ExecuteQueryCommand}" /><Button Text="Clear" Command="{Binding ClearCommand}" /></HorizontalStackLayout>
   <Label Text="Quick Queries" Style="{StaticResource Title3}" />
   <FlexLayout Direction="Row" Wrap="Wrap">
    <Button Text="Tables" Command="{Binding TablesQueryCommand}" Margin="0,0,8,8" /><Button Text="Shop Schema" Command="{Binding ShopSchemaQueryCommand}" Margin="0,0,8,8" /><Button Text="Bill Schema" Command="{Binding BillSchemaQueryCommand}" Margin="0,0,8,8" /><Button Text="Counts" Command="{Binding CountsQueryCommand}" Margin="0,0,8,8" />
   </FlexLayout>
   <Label Text="{Binding Status}" FontAttributes="Bold" />
   <Label Text="{Binding Error}" TextColor="{DynamicResource Danger}" IsVisible="{Binding HasError}" />
   <Label Text="Results" Style="{StaticResource Title3}" />
   <Label Text="{Binding ResultSummary}" IsVisible="{Binding HasResults}" />
   <Label Text="{Binding TruncationText}" IsVisible="{Binding IsTruncated}" TextColor="{DynamicResource Danger}" />
   <Button Text="Copy Selected Value to Query" Command="{Binding CopySelectedValueToQueryCommand}" IsEnabled="{Binding HasSelectedSqlValue}" HorizontalOptions="Start" />
   <ScrollView Orientation="Both" HeightRequest="360" IsVisible="{Binding HasResults}">
    <VerticalStackLayout Spacing="0">
     <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Columns}" Spacing="18"><BindableLayout.ItemTemplate><DataTemplate><Label Text="{Binding .}" FontAttributes="Bold" MinimumWidthRequest="110"><Label.GestureRecognizers><TapGestureRecognizer Command="{Binding BindingContext.SelectSqlValueCommand, Source={x:Reference AnalyzerPage}}" CommandParameter="{Binding .}" /></Label.GestureRecognizers></Label></DataTemplate></BindableLayout.ItemTemplate></HorizontalStackLayout>
     <CollectionView ItemsSource="{Binding Rows}" SelectionMode="None" HeightRequest="320"><CollectionView.ItemTemplate><DataTemplate><HorizontalStackLayout BindableLayout.ItemsSource="{Binding .}" Spacing="18"><BindableLayout.ItemTemplate><DataTemplate><Label Text="{Binding .}" MinimumWidthRequest="110"><Label.GestureRecognizers><TapGestureRecognizer Command="{Binding BindingContext.SelectSqlValueCommand, Source={x:Reference AnalyzerPage}}" CommandParameter="{Binding .}" /></Label.GestureRecognizers></Label></DataTemplate></BindableLayout.ItemTemplate></HorizontalStackLayout></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    </VerticalStackLayout>
   </ScrollView>
  </VerticalStackLayout></ScrollView>
  <controls:ProcessingOverlay Grid.Row="0" IsBusy="{Binding IsBusy}" Message="{Binding Status}" ShowStop="{Binding IsBusy}" StopEnabled="{Binding IsStopping, Converter={StaticResource InvertedBoolConverter}}" StopCommand="{Binding StopQueryCommand}" />
  <controls:BottomTaskBar Grid.Row="1" />
 </Grid>
</ContentPage>
