<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pageModels="clr-namespace:FinTracker.PageModels" xmlns:controls="clr-namespace:FinTracker.Pages.Controls" x:Class="FinTracker.Pages.BackupRestorePage" x:DataType="pageModels:BackupRestorePageModel" Title="Backup &amp; Restore">
 <Grid RowDefinitions="*,Auto">
  <VerticalStackLayout Grid.Row="0" Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">
  <Label Text="Backup &amp; Restore" Style="{StaticResource Title2}" />
  <Button Text="Backup Data" Command="{Binding OpenBackupCommand}" />
  <Label Text="Create a backup of your application data." />
  <Button Text="Restore Data" Command="{Binding OpenRestoreCommand}" />
  <Label Text="Restore application data from a backup file." />
  </VerticalStackLayout>
  <controls:BottomTaskBar Grid.Row="1" />
 </Grid>
</ContentPage>
